---
import Closing from '../components/Closing.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import Hero from '../components/Hero.astro';
import InteractionHighlights from '../components/InteractionHighlights.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StatementBand from '../components/StatementBand.astro';
import Layout from '../layouts/Layout.astro';

const appBaseUrl = (import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173').replace(/\/+$/, '');
const loginHref = `${appBaseUrl}/login`;
const signupHref = `${appBaseUrl}/signup`;
---

<Layout
	title="Aska | A visual archive for creative work"
	description="Aska is a quieter home for visual references, ideas, and moodboards."
>
	<SiteHeader loginHref={loginHref} signupHref={signupHref} />
	<main>
		<Hero signupHref={signupHref} />
		<StatementBand />
		<FeatureShowcase />
		<InteractionHighlights />
		<Closing signupHref={signupHref} />
	</main>
	<SiteFooter loginHref={loginHref} signupHref={signupHref} />
</Layout>

<style>
	main { position: relative; z-index: 1; margin: 6px 6px 0; border-radius: 18px 18px 0 0; background: var(--canvas); isolation: isolate; }
	main::after { position: absolute; right: 0; bottom: -22px; left: 0; z-index: 2; height: 22px; border-radius: 0 0 18px 18px; background: var(--canvas); box-shadow: 0 1px 0 rgb(21 21 21 / 8%); content: ""; pointer-events: none; }

	@media (max-width: 640px) {
		main { border-radius: 14px 14px 0 0; }
		main::after { bottom: -16px; height: 16px; border-radius: 0 0 14px 14px; }
	}
</style>

---
import { Image, getImage } from 'astro:assets';
import bauhausArchitecture01 from '../assets/images/bauhaus-architecture-01.jpg';
import bauhausFurniture01 from '../assets/images/bauhaus-furniture-01.jpg';
import bauhausFurniture02 from '../assets/images/bauhaus-furniture-02.jpg';
import bauhausFurniture03 from '../assets/images/bauhaus-furniture-03.jpg';
import bauhausRoom01 from '../assets/images/bauhaus-room-01.jpg';
import bauhausRoom02 from '../assets/images/bauhaus-room-02.jpg';
import blueRedWall from '../assets/images/blue-red-wall.jpg';
import brutalistShadows from '../assets/images/brutalist-shadows.jpg';
import concreteSculptures from '../assets/images/concrete-sculptures.jpg';
import curvedArchitecture from '../assets/images/curved-architecture.jpg';
import greenAbstract02 from '../assets/images/green-abstract-02.webp';
import greenAbstract03 from '../assets/images/green-abstract-03.webp';
import greenAbstract05 from '../assets/images/green-abstract-05.webp';
import greenAbstract07 from '../assets/images/green-abstract-07.webp';
const mockImageProps = { width: 280, densities: [1, 2], quality: 78 };
const mockImages = [
	blueRedWall,
	curvedArchitecture,
	brutalistShadows,
	concreteSculptures,
	greenAbstract05,
	greenAbstract02,
	greenAbstract03,
	greenAbstract07,
	bauhausRoom01,
	bauhausFurniture01,
	bauhausFurniture02,
	bauhausFurniture03,
	bauhausArchitecture01,
	bauhausRoom02,
];
const getBlurStyle = async (image) => {
	const placeholder = await getImage({ src: image, width: 28, format: 'webp', quality: 30 });
	return `--blur-image: url("${placeholder.src}");`;
};
const mockBlurStyles = Object.fromEntries(
	await Promise.all(mockImages.map(async (image) => [image.src, await getBlurStyle(image)])),
);
const withMockBlur = (image) => ({ ...mockImageProps, src: image, class: 'blur-image', style: mockBlurStyles[image.src] });
---

<section id="workflow" class="feature-showcase page-width scroll-anchor" aria-label="Aska features">
	<article class="feature-panel feature-panel--capture">
		<div class="feature-panel__copy">
			<h2>Everything lands in one place first.</h2>
			<p>Images, videos, rich links, and quick notes arrive in the Inbox until you are ready to sort them.</p>
		</div>
		<div class="capture-preview" role="img" aria-label="An Aska inbox containing different kinds of saved references">
			<div class="capture-topbar" aria-hidden="true">
				<button aria-label="Toggle sidebar">
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg>
				</button>
				<span>Inbox</span>
			</div>
			<div class="capture-board" aria-hidden="true">
				<div class="inbox-asset inbox-asset--image inbox-asset--tall"><Image {...withMockBlur(blueRedWall)} alt="" /></div>
				<div class="inbox-asset inbox-asset--note">
					<p><strong>Keep the useful friction.</strong></p>
					<p>Pull in the fragments before the direction is obvious.</p>
				</div>
				<div class="inbox-asset inbox-asset--image inbox-asset--wide"><Image {...withMockBlur(curvedArchitecture)} alt="" /></div>
				<div class="inbox-asset inbox-asset--image"><Image {...withMockBlur(brutalistShadows)} alt="" /></div>
				<div class="inbox-asset inbox-asset--image"><Image {...withMockBlur(concreteSculptures)} alt="" /></div>
				<div class="inbox-asset inbox-asset--note inbox-asset--small-note">
					<p>Ask whether the palette is doing work or just decorating.</p>
				</div>
			</div>
		</div>
	</article>

	<article id="archive" class="feature-panel feature-panel--search scroll-anchor">
		<div class="feature-panel__copy">
			<h2>Search beyond file names.</h2>
			<p>Use color-based search and text search to find the references you saved in a collection.</p>
		</div>
		<div class="search-preview" role="img" aria-label="An Aska colour search showing forest-green abstract references">
			<div class="search-topbar" aria-hidden="true">
				<button aria-label="Toggle sidebar">
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg>
				</button>
				<nav class="search-breadcrumbs" aria-label="Collection path"><span>Collections</span><i>/</i><strong>Colour studies</strong></nav>
			</div>
			<div class="search-board" aria-hidden="true">
				<div class="colour-filter"><i></i><i></i><i></i><i></i><i></i><span>Forest green</span></div>
				<div class="search-results">
					<div class="search-result search-result--one"><Image {...withMockBlur(greenAbstract05)} alt="" /></div>
					<div class="search-result search-result--two"><Image {...withMockBlur(greenAbstract02)} alt="" /></div>
					<div class="search-result search-result--three"><Image {...withMockBlur(greenAbstract03)} alt="" /></div>
					<div class="search-result search-result--four"><Image {...withMockBlur(greenAbstract07)} alt="" /></div>
				</div>
			</div>
		</div>
	</article>

	<article class="feature-panel feature-panel--canvas">
		<div class="feature-panel__copy">
			<h2>Arrange ideas as they start to take shape.</h2>
			<p>Move references, notes and folders on a canvas as the project continues to evolve.</p>
		</div>
		<div class="canvas-preview" role="img" aria-label="An Aska collection canvas with references positioned in a moodboard">
			<div class="canvas-preview__top">
				<button aria-label="Toggle sidebar">
					<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg>
				</button>
				<nav class="canvas-breadcrumbs" aria-label="Collection path"><span>Collections</span><i>/</i><strong>Bauhaus</strong></nav>
				<span class="canvas-preview__count">48 items</span>
			</div>
			<div class="canvas-grid" aria-hidden="true">
				<div class="canvas-object canvas-object--image-one"><Image {...withMockBlur(bauhausRoom01)} alt="" /></div>
				<div class="canvas-object canvas-object--folder">
					<div class="canvas-folder__previews"><Image {...withMockBlur(bauhausFurniture01)} alt="" /><Image {...withMockBlur(bauhausFurniture02)} alt="" /><Image {...withMockBlur(bauhausFurniture03)} alt="" /><span></span></div>
					<div class="canvas-folder__label"><strong>Furniture</strong><small>24</small></div>
				</div>
				<div class="canvas-object canvas-object--note"><p><strong>Keep the useful friction.</strong></p><p>Every reference needs room around it.</p></div>
				<div class="canvas-object canvas-object--image-two"><Image {...withMockBlur(bauhausArchitecture01)} alt="" /></div>
				<div class="canvas-object canvas-object--image-three"><Image {...withMockBlur(bauhausRoom02)} alt="" /></div>
			</div>
		</div>
	</article>
</section>

<script>
	const featurePanels = Array.from(document.querySelectorAll<HTMLElement>('.feature-panel'));
	const featureListeners = new AbortController();

	if (window.matchMedia('(hover: hover)').matches) {
		featurePanels.forEach((panel) => {
			panel.addEventListener('mouseenter', () => panel.classList.add('is-preview-active'), {
				signal: featureListeners.signal,
			});
			panel.addEventListener('mouseleave', () => panel.classList.remove('is-preview-active'), {
				signal: featureListeners.signal,
			});
		});

		document.addEventListener('astro:before-swap', () => featureListeners.abort(), { once: true });
	}
</script>

<style>
	.feature-showcase { --mock-asset-border: rgb(21 21 21 / 10%); --mock-muted-card-border: rgb(222 222 217 / 72%); display: grid; max-width: 980px; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; }
	.feature-panel, .feature-detail { min-width: 0; border: 1px solid var(--line); border-radius: 7px; background: var(--surface); box-shadow: 0 2px 8px rgb(21 21 21 / 3%); }
	.feature-panel { display: flex; flex-direction: column; overflow: hidden; padding: 30px; }
	.feature-panel--capture { grid-column: span 7; }
	.feature-panel--search { grid-column: span 5; }
	.feature-panel--canvas { display: grid; grid-column: 1 / -1; grid-template-columns: minmax(220px, .46fr) minmax(0, 1.54fr); align-items: center; gap: 44px; padding: 38px; }
	.feature-panel__copy { max-width: 420px; margin-bottom: 24px; }
	.feature-panel__copy h2 { margin-bottom: 10px; font-size: clamp(23px, 2.4vw, 32px); line-height: 1.12; }
	.feature-panel__copy p { margin: 0; color: var(--ink-muted); font-size: 13px; line-height: 1.55; }
	.feature-panel--capture .capture-preview { --preview-x: 18px; --preview-y: 74px; width: calc(100% + 58px); transform: translate(var(--preview-x), var(--preview-y)); }
	.feature-panel--search .search-preview { --preview-x: 18px; --preview-y: 66px; width: calc(100% + 54px); margin-top: auto; transform: translate(var(--preview-x), var(--preview-y)); }
	.feature-panel--canvas .canvas-preview { --preview-x: 70px; --preview-y: 76px; --preview-hover-x: calc(var(--preview-x) - 22px); width: calc(100% + 92px); transform: translate(var(--preview-x), var(--preview-y)); }

	.capture-preview, .search-preview, .canvas-preview { border: 1px solid var(--feature-frame-border-mid); border-radius: 8px; background: rgb(255 255 255 / 64%); box-shadow: var(--feature-frame-shadow-mid); }
	.feature-showcase .capture-preview, .feature-showcase .search-preview, .feature-showcase .canvas-preview { transition: transform 460ms cubic-bezier(.22, .8, .24, 1); will-change: transform; }
	.capture-preview { position: relative; min-height: 350px; overflow: hidden; padding: 0 8px 8px; background: #fff; }
	.capture-topbar, .search-topbar { display: flex; align-items: center; gap: 8px; height: 46px; padding: 0 8px 0 0; border-radius: 8px 8px 0 0; background: transparent; color: #252522; }
	.capture-topbar button, .search-topbar button, .canvas-preview__top button { display: grid; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 8px; background: transparent; color: #252522; place-items: center; }
	.capture-topbar svg, .search-topbar svg, .canvas-preview__top svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
	.capture-topbar > span { display: flex; align-items: center; height: 28px; font-size: 13px; font-weight: 500; line-height: 1; }
	.capture-board { columns: 3 96px; column-gap: 12px; padding: 12px; border-radius: 10px; background: var(--canvas); box-shadow: 0 1px 2px rgb(21 21 21 / 4%); }
	.inbox-asset { position: relative; display: block; min-width: 0; margin-bottom: 12px; overflow: hidden; break-inside: avoid; border-radius: 8px; }
	.inbox-asset--image { aspect-ratio: 1 / 1.2; border: 1px solid var(--mock-asset-border); background: #e8e8e3; }
	.inbox-asset--image img { display: block; width: 100%; height: 100%; border-radius: 6px; object-fit: cover; }
	.inbox-asset--tall { aspect-ratio: 1 / 1.5; }
	.inbox-asset--wide { aspect-ratio: 1 / .86; }
	.inbox-asset--wide img { object-position: center 54%; }
	.inbox-asset--note { max-height: 162px; padding: 14px; border: 1px solid var(--mock-asset-border); background: #fff; color: #252522; font-size: 12px; line-height: 1.45; }
	.inbox-asset--note p { margin: 0; }
	.inbox-asset--note p + p { margin-top: 9px; color: #5f5f59; }
	.inbox-asset--note strong { font-weight: 600; }
	.inbox-asset--small-note { max-height: none; padding: 12px; font-size: 11px; }
	.search-preview { position: relative; min-height: 320px; overflow: hidden; padding: 0 8px 8px; background: #fff; }
	.search-board { padding: 12px; border-radius: 10px; background: var(--canvas); box-shadow: 0 1px 2px rgb(21 21 21 / 4%); }
	.search-breadcrumbs, .canvas-breadcrumbs { display: flex; align-items: center; min-width: 0; gap: 8px; height: 28px; font-size: 13px; font-weight: 500; line-height: 1; }
	.search-breadcrumbs span, .search-breadcrumbs strong, .canvas-breadcrumbs span, .canvas-breadcrumbs strong, .canvas-preview__count { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.search-breadcrumbs span, .search-breadcrumbs i, .canvas-breadcrumbs span, .canvas-breadcrumbs i, .canvas-preview__count { color: #6d6d67; }
	.search-breadcrumbs i, .canvas-breadcrumbs i { font-style: normal; }
	.search-breadcrumbs strong, .canvas-breadcrumbs strong { color: #252522; font-weight: 500; }
	.colour-filter { display: flex; align-items: center; gap: 6px; padding: 4px 2px 13px; color: #777771; font-size: 9px; }
	.colour-filter i { width: 18px; height: 18px; border: 1px solid rgb(0 0 0 / 8%); border-radius: 5px; }
	.colour-filter i:nth-child(1) { background: #173a2a; }
	.colour-filter i:nth-child(2) { background: #2f5a3f; }
	.colour-filter i:nth-child(3) { background: #527258; }
	.colour-filter i:nth-child(4) { background: #7e9476; }
	.colour-filter i:nth-child(5) { background: #aebba0; }
	.colour-filter span { margin-left: 4px; }
	.search-results { display: grid; grid-template-columns: 1.14fr .86fr 1fr; grid-template-rows: 104px 130px; gap: 8px; }
	.search-result { position: relative; overflow: hidden; border: 1px solid var(--mock-muted-card-border); border-radius: 8px; background: #d9dedc; }
	.search-result img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.search-result--one { grid-row: span 2; }
	.search-result--four { grid-column: span 2; }

	.canvas-preview { position: relative; min-height: 378px; overflow: hidden; padding: 0 8px 8px; background: #fff; }
	.canvas-preview__top { position: relative; z-index: 1; display: flex; align-items: center; gap: 8px; height: 46px; padding: 0 8px 0 0; border: 0; background: transparent; color: #6d6d67; }
	.canvas-preview__count { margin-left: auto; font-size: 10px; line-height: 1; }
	.canvas-grid { position: relative; height: 385px; overflow: hidden; border-radius: 10px; background-color: var(--canvas); background-image: radial-gradient(circle, rgb(21 21 21 / 22%) .65px, transparent .8px); background-position: 0 0; background-size: 24px 24px; box-shadow: 0 1px 2px rgb(21 21 21 / 4%); }
	.canvas-object { position: absolute; overflow: hidden; border: 1px solid var(--mock-asset-border); border-radius: 6px; background: #fff; box-shadow: 0 3px 8px rgb(21 21 21 / 5%); }
	.canvas-object img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.canvas-object--image-one { top: 40px; left: 13%; width: 148px; height: 182px; }
	.canvas-object--image-one img { object-position: 44% center; }
	.canvas-object--image-two { top: 76px; left: 52%; width: 154px; height: 112px; }
	.canvas-object--image-two img { object-position: center 43%; }
	.canvas-object--image-three { right: 8%; bottom: 31px; width: 145px; height: 102px; }
	.canvas-object--image-three img { object-position: center 53%; }
	.canvas-object--folder { top: 193px; left: 29%; width: 174px; height: 184px; }
	.canvas-folder__previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px; padding: 6px; aspect-ratio: 1; }
	.canvas-folder__previews img, .canvas-folder__previews span { min-width: 0; min-height: 0; border-radius: 2px; background: #eef0ed; object-fit: cover; aspect-ratio: 1; }
	.canvas-folder__label { position: absolute; right: 1px; bottom: 1px; left: 1px; display: flex; align-items: center; gap: 6px; padding: 7px 8px; border-radius: 0 0 5px 5px; background: rgb(255 255 255 / 86%); color: #3d3d39; backdrop-filter: blur(10px); }
	.canvas-folder__label strong { overflow: hidden; font-size: 9px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
	.canvas-folder__label small { margin-left: auto; color: #8a8a84; font-size: 8px; }
	.canvas-object--note { right: 6%; bottom: 152px; width: 166px; padding: 13px; color: #454540; text-align: left; }
	.canvas-object--note p { margin: 0; font-size: 10px; line-height: 1.35; }
	.canvas-object--note p + p { margin-top: 7px; color: #777771; }
	.canvas-object--note strong { font-weight: 600; }
	@media (hover: hover) {
		.feature-panel--capture:is(:hover, .is-preview-active) .capture-preview, .feature-panel--search:is(:hover, .is-preview-active) .search-preview { transform: translate3d(var(--preview-x), calc(var(--preview-y) - 22px), 0); }
		.feature-panel--canvas:is(:hover, .is-preview-active) .canvas-preview { transform: translate3d(var(--preview-hover-x), calc(var(--preview-y) - 22px), 0); }
	}


	:global(html[data-theme='dark']) .feature-showcase { --mock-asset-border: oklch(1 0 0 / 10%); --mock-muted-card-border: oklch(1 0 0 / 10%); }
	:global(html[data-theme='dark']) .feature-panel { box-shadow: 0 2px 10px rgb(0 0 0 / 18%); }
	:global(html[data-theme='dark']) .capture-preview,
	:global(html[data-theme='dark']) .search-preview,
	:global(html[data-theme='dark']) .canvas-preview { background: rgb(14 16 14 / 76%); }
	:global(html[data-theme='dark']) .capture-preview,
	:global(html[data-theme='dark']) .search-preview { background: #000; }
	:global(html[data-theme='dark']) .capture-topbar,
	:global(html[data-theme='dark']) .search-topbar { color: var(--ink); }
	:global(html[data-theme='dark']) .capture-board,
	:global(html[data-theme='dark']) .search-board { background: var(--canvas); color: var(--ink); box-shadow: 0 1px 2px rgb(0 0 0 / 28%); }
	:global(html[data-theme='dark']) .capture-topbar button,
	:global(html[data-theme='dark']) .search-topbar button,
	:global(html[data-theme='dark']) .canvas-preview__top button { color: var(--ink); }
	:global(html[data-theme='dark']) .inbox-asset--image { background: var(--surface-muted); }
	:global(html[data-theme='dark']) .inbox-asset--note { background: var(--surface); color: var(--ink); }
	:global(html[data-theme='dark']) .inbox-asset--note p + p { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .canvas-preview { background: #000; }
	:global(html[data-theme='dark']) .canvas-preview__top { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .search-breadcrumbs span,
	:global(html[data-theme='dark']) .search-breadcrumbs i,
	:global(html[data-theme='dark']) .canvas-breadcrumbs span,
	:global(html[data-theme='dark']) .canvas-breadcrumbs i,
	:global(html[data-theme='dark']) .canvas-preview__count { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .search-breadcrumbs strong,
	:global(html[data-theme='dark']) .canvas-breadcrumbs strong { color: var(--ink); }
	:global(html[data-theme='dark']) .canvas-grid { background-color: var(--canvas); background-image: radial-gradient(circle, rgb(241 243 238 / 25%) .62px, transparent .78px); background-size: 24px 24px; box-shadow: 0 1px 2px rgb(0 0 0 / 28%); }
	:global(html[data-theme='dark']) .canvas-object { background: var(--surface); box-shadow: 0 3px 10px rgb(0 0 0 / 24%); }
	:global(html[data-theme='dark']) .canvas-folder__previews img,
	:global(html[data-theme='dark']) .canvas-folder__previews span { background: var(--surface-muted); }
	:global(html[data-theme='dark']) .canvas-folder__label { color: var(--ink); background: rgb(0 0 0 / 94%); }
	:global(html[data-theme='dark']) .canvas-folder__label small { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .canvas-object--note { color: var(--ink); }
	:global(html[data-theme='dark']) .canvas-object--note p + p { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .colour-filter { color: var(--ink-muted); }

	@media (max-width: 820px) {
		.feature-panel--capture, .feature-panel--search, .feature-panel--canvas { grid-column: 1 / -1; }
		.feature-panel--canvas { grid-template-columns: 1fr; gap: 30px; }
		.feature-panel--capture .capture-preview, .feature-panel--search .search-preview { --preview-x: 12px; --preview-y: 58px; width: calc(100% + 38px); transform: translate(var(--preview-x), var(--preview-y)); }
		.feature-panel--canvas .canvas-preview { --preview-x: 28px; --preview-y: 62px; --preview-hover-x: var(--preview-x); width: calc(100% + 58px); transform: translate(var(--preview-x), var(--preview-y)); }
	}

	@media (max-width: 640px) {
		.feature-showcase { gap: 8px; }
		.feature-panel { padding: 22px; }
		.feature-panel--capture .capture-preview, .feature-panel--search .search-preview { --preview-x: 12px; --preview-y: 48px; width: calc(100% + 34px); transform: translate(var(--preview-x), var(--preview-y)); }
		.feature-panel--canvas .canvas-preview { --preview-x: 18px; --preview-y: 48px; --preview-hover-x: var(--preview-x); width: calc(100% + 54px); transform: translate(var(--preview-x), var(--preview-y)); }
		.capture-preview { min-height: 314px; }
		.search-preview { min-height: 296px; }
		.canvas-preview { min-height: 316px; }
		.canvas-grid { width: auto; height: 316px; }
		.canvas-object--image-one { left: 8%; width: 104px; height: 138px; }
		.canvas-object--image-two { left: 47%; width: 112px; height: 84px; }
		.canvas-object--folder { top: 154px; left: 23%; width: 130px; height: 132px; }
		.canvas-object--image-three, .canvas-object--note { display: none; }
	}

	@media (prefers-reduced-transparency: reduce) {
		.capture-preview, .search-preview, .canvas-preview { background: var(--surface); backdrop-filter: none; }
	}
</style>

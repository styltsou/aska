---
import { HeaderInner } from './HeaderInner';
interface Props {
	loginHref: string;
	signupHref: string;
}

const { loginHref, signupHref } = Astro.props;
---

<header class="site-header">
	<HeaderInner client:load loginHref={loginHref} signupHref={signupHref} />
</header>

<style is:global>
	.site-header { position: fixed; inset: 10px 0 auto; z-index: 20; pointer-events: none; }
	.site-header__inner { width: min(calc(100% - 48px), 980px); min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-inline: auto; padding: 4px 5px 4px 12px; border: 1px solid var(--glass-line); border-radius: 8px; background: var(--glass-surface); box-shadow: 0 5px 14px rgb(21 21 21 / 5%); backdrop-filter: blur(22px) saturate(150%); pointer-events: auto; }
	.site-header__row { display: flex; align-items: center; justify-content: space-between; gap: 18px; width: 100%; }
	.brand { display: inline-flex; align-items: center; }
	.brand__logo { width: 76px; height: 25px; display: block; }
	.desktop-nav, .desktop-actions { display: flex; align-items: center; gap: 20px; }
	.desktop-nav { margin-right: 4px; margin-left: auto; }
	.desktop-nav a, .text-link { color: var(--ink-muted); font-size: 13px; font-weight: 500; transition: color 140ms ease; }
	.desktop-actions .button { min-height: 32px; padding-inline: 11px; font-size: 12px; }
	.mobile-menu-toggle, .mobile-menu-content { display: none; }

	@media (hover: hover) {
		.desktop-nav a:hover, .text-link:hover { color: var(--ink); }
		.mobile-menu-nav a:hover { color: var(--ink); }
	}

	@media (hover: none) {
		.mobile-menu-nav a:active, .text-link:active { color: var(--ink); }
	}


	html[data-theme='dark'] .brand__logo { filter: invert(1); }
	html[data-theme='dark'] .site-header__inner { box-shadow: 0 5px 18px rgb(0 0 0 / 28%); }

	@media (max-width: 640px) {
		html.has-mobile-menu { overflow: hidden; }
		.site-header { inset: 0; z-index: 30; }
		.site-header__inner { position: fixed; z-index: 1; top: 8px; left: 16px; right: 16px; height: 46px; min-height: 0; width: auto; margin-inline: 0; padding: 4px 12px; border: 1px solid var(--glass-line); border-radius: 8px; background: var(--glass-surface); backdrop-filter: blur(22px) saturate(150%); overflow: hidden; display: flex; flex-direction: column; transition: top 360ms cubic-bezier(.22, .8, .24, 1), left 360ms cubic-bezier(.22, .8, .24, 1), right 360ms cubic-bezier(.22, .8, .24, 1), height 360ms cubic-bezier(.22, .8, .24, 1), border-radius 360ms cubic-bezier(.22, .8, .24, 1), border 360ms cubic-bezier(.22, .8, .24, 1), backdrop-filter 360ms cubic-bezier(.22, .8, .24, 1); pointer-events: auto; }
		.site-header__inner[data-menu-open] { top: 0; left: 0; right: 0; height: 100%; border-radius: 0; border: none; box-shadow: none; backdrop-filter: none; }
		.site-header__row { flex-shrink: 0; gap: 0; }
		.mobile-menu-toggle, .mobile-menu-content { display: flex; }
		.desktop-nav, .desktop-actions { display: none; }
		.mobile-menu-toggle { width: 46px; height: 38px; flex: 0 0 46px; padding: 0; border: 0; color: var(--ink); background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: flex-end; }
		.mobile-menu-toggle__icon { position: relative; width: 21px; height: 14px; display: block; }
		.mobile-menu-toggle__icon span { position: absolute; top: 50%; right: 0; height: 2px; border-radius: 2px; background: currentColor; transform-origin: center; transition: width 260ms cubic-bezier(.22, .8, .24, 1), transform 320ms cubic-bezier(.22, .8, .24, 1); }
		.mobile-menu-toggle__icon span:first-child { width: 21px; transform: translateY(-3px); }
		.mobile-menu-toggle__icon span:last-child { width: 13px; transform: translateY(3px); }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span { width: 19px; }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span:first-child { transform: translateY(-1px) rotate(45deg); }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span:last-child { transform: translateY(-1px) rotate(-45deg); }

		.mobile-menu-content { flex: 1; flex-direction: column; justify-content: space-between; padding: 40px 0 20px; opacity: 0; visibility: hidden; transition: opacity 200ms ease, visibility 200ms ease; pointer-events: none; }
		.site-header__inner[data-menu-open] .mobile-menu-content { opacity: 1; visibility: visible; transition-delay: 100ms; pointer-events: auto; }
		.mobile-menu-nav { display: grid; gap: 18px; }
		.mobile-menu-nav a { padding: 4px 0; font-size: clamp(34px, 11vw, 48px); font-weight: 560; line-height: 1; color: var(--ink-muted); transition: color 140ms ease; }
		.mobile-menu-footer { display: grid; gap: 12px; }
		.mobile-menu-footer .button { width: 100%; min-height: 46px; font-size: 14px; }
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__inner, .mobile-menu-content, .desktop-nav a, .text-link, .mobile-menu-nav a, .mobile-menu-toggle__icon span { transition: none; }
	}

	@media (prefers-reduced-transparency: reduce) {
		.site-header__inner { background: var(--surface); backdrop-filter: none; }
	}
</style>

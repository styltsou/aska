---
interface Props {
	loginHref: string;
	signupHref: string;
}

const { loginHref, signupHref } = Astro.props;
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="#top" aria-label="Aska home">
			<img class="brand__logo" src="/aska-logo.svg" alt="" />
		</a>
		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="#product">Product</a>
			<a href="#workflow">Workflow</a>
			<a href="#archive">Archive</a>
		</nav>
		<div class="desktop-actions">
			<a class="text-link" href={loginHref}>Log in</a>
			<a class="button button--primary" href={signupHref}>Create account</a>
		</div>
		<button class="mobile-menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
			<span class="mobile-menu-toggle__icon" aria-hidden="true">
				<span></span>
				<span></span>
			</span>
		</button>
	</div>
</header>

<div id="mobile-menu" class="mobile-menu-drawer" aria-hidden="true" inert>
	<div class="mobile-menu-drawer__inner">
		<nav class="mobile-menu-drawer__nav" aria-label="Mobile navigation">
			<a href="#product">Product</a>
			<a href="#workflow">Workflow</a>
			<a href="#archive">Archive</a>
		</nav>
		<div class="mobile-menu-drawer__actions">
			<a class="text-link" href={loginHref}>Log in</a>
			<a class="button button--primary" href={signupHref}>Create account</a>
		</div>
	</div>
</div>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
	const menuDrawer = document.querySelector<HTMLElement>('.mobile-menu-drawer');
	const menuListeners = new AbortController();

	if (header && menuToggle && menuDrawer) {
		const setMenuOpen = (isOpen: boolean) => {
			menuToggle.setAttribute('aria-expanded', String(isOpen));
			menuToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
			menuDrawer.setAttribute('aria-hidden', String(!isOpen));
			menuDrawer.toggleAttribute('inert', !isOpen);
			menuDrawer.classList.toggle('is-open', isOpen);
			document.documentElement.classList.toggle('has-mobile-menu', isOpen);

			if (isOpen) menuDrawer.querySelector<HTMLAnchorElement>('a')?.focus();
			else menuToggle.focus();
		};

		menuToggle.addEventListener('click', () => {
			setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
		}, { signal: menuListeners.signal });

		menuDrawer.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setMenuOpen(false);
		}, { signal: menuListeners.signal });

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') setMenuOpen(false);
		}, { signal: menuListeners.signal });
	}

	document.addEventListener('astro:before-swap', () => menuListeners.abort(), { once: true });
</script>

<style>
	.site-header { position: fixed; inset: 10px 0 auto; z-index: 20; pointer-events: none; }
	.site-header__inner { width: min(calc(100% - 48px), 980px); min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-inline: auto; padding: 4px 5px 4px 12px; border: 1px solid var(--glass-line); border-radius: 8px; background: var(--glass-surface); box-shadow: 0 5px 14px rgb(21 21 21 / 5%); backdrop-filter: blur(22px) saturate(150%); pointer-events: auto; }
	.brand { display: inline-flex; align-items: center; }
	.brand__logo { width: 76px; height: 25px; display: block; }
	.desktop-nav, .desktop-actions { display: flex; align-items: center; gap: 20px; }
	.desktop-nav { margin-right: 4px; margin-left: auto; }
	.desktop-nav a, .text-link { color: var(--ink-muted); font-size: 13px; font-weight: 500; transition: color 140ms ease; }
	.desktop-actions .button { min-height: 32px; padding-inline: 11px; font-size: 12px; }
	.mobile-menu-toggle, .mobile-menu-drawer { display: none; }

	@media (hover: hover) {
		.desktop-nav a:hover, .text-link:hover { color: var(--ink); }
	}

	@media (hover: none) {
		.mobile-menu-drawer__nav a:active, .text-link:active { color: var(--ink); }
	}


	:global(html[data-theme='dark']) .brand__logo { filter: invert(1); }
	:global(html[data-theme='dark']) .site-header__inner { box-shadow: 0 5px 18px rgb(0 0 0 / 28%); }

	@media (max-width: 640px) {
		:global(html.has-mobile-menu) { overflow: hidden; }
		.site-header { inset: 8px 0 auto; z-index: 30; }
		.site-header__inner { width: min(calc(100% - 32px), var(--page-width)); min-height: 46px; padding-left: 12px; }
		.desktop-nav, .desktop-actions { display: none; }
		.mobile-menu-toggle { width: 46px; height: 38px; display: inline-grid; flex: 0 0 46px; padding: 0; border: 0; color: var(--ink); background: transparent; cursor: pointer; place-items: center; }
		.mobile-menu-toggle__icon { position: relative; width: 21px; height: 14px; display: block; }
		.mobile-menu-toggle__icon span { position: absolute; top: 50%; right: 0; height: 2px; border-radius: 2px; background: currentColor; transform-origin: center; transition: width 260ms cubic-bezier(.22, .8, .24, 1), transform 320ms cubic-bezier(.22, .8, .24, 1); }
		.mobile-menu-toggle__icon span:first-child { width: 21px; transform: translateY(-3px); }
		.mobile-menu-toggle__icon span:last-child { width: 13px; transform: translateY(3px); }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span { width: 19px; }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span:first-child { transform: translateY(-1px) rotate(45deg); }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span:last-child { transform: translateY(-1px) rotate(-45deg); }
		.mobile-menu-drawer { position: fixed; inset: 0; z-index: 25; display: block; visibility: hidden; overflow: hidden; background: rgb(243 244 241 / 68%); opacity: 0; pointer-events: none; transform: translateY(-14px); transition: opacity 260ms ease, transform 360ms cubic-bezier(.22, .8, .24, 1), visibility 0s linear 360ms; backdrop-filter: blur(40px) saturate(155%); -webkit-backdrop-filter: blur(40px) saturate(155%); }
		.mobile-menu-drawer.is-open { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0); transition-delay: 0s; }
		.mobile-menu-drawer__inner { width: min(calc(100% - 48px), 520px); height: 100dvh; display: flex; flex-direction: column; justify-content: space-between; margin-inline: auto; padding: 112px 0 36px; }
		.mobile-menu-drawer__nav { display: grid; gap: 18px; }
		.mobile-menu-drawer__nav a { padding: 4px 0; font-size: clamp(34px, 11vw, 48px); font-weight: 560; line-height: 1; }
		.mobile-menu-drawer__actions { display: grid; gap: 12px; padding-top: 24px; border-top: 1px solid var(--line); }
		.mobile-menu-drawer__actions .text-link { color: var(--ink-muted); font-size: 15px; font-weight: 500; }
		.mobile-menu-drawer__actions .button { width: 100%; min-height: 46px; font-size: 14px; }
	}

	@media (max-width: 640px) {
		:global(html[data-theme='dark']) .mobile-menu-drawer { background: rgb(0 0 0 / 68%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.desktop-nav a, .text-link { transition: none; }
	}

	@media (prefers-reduced-transparency: reduce) {
		.site-header__inner, .mobile-menu-drawer { background: var(--surface); backdrop-filter: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu-drawer, .mobile-menu-toggle__icon span { transition: none; }
	}
</style>

---
interface Props {
	loginHref: string;
	signupHref: string;
}

const { loginHref, signupHref } = Astro.props;
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="brand" href="#top" aria-label="Aska home">
			<img class="brand__logo" src="/aska-logo.svg" alt="" />
		</a>
		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="#product">Product</a>
			<a href="#workflow">Workflow</a>
			<a href="#archive">Archive</a>
		</nav>
		<div class="desktop-actions">
			<a class="text-link" href={loginHref}>Log in</a>
			<a class="button button--primary" href={signupHref}>Create account</a>
		</div>
		<details class="mobile-nav">
			<summary>Menu</summary>
			<div class="mobile-nav__panel">
				<a href="#product">Product</a>
				<a href="#workflow">Workflow</a>
				<a href="#archive">Archive</a>
				<a href={loginHref}>Log in</a>
				<a class="button button--primary" href={signupHref}>Create account</a>
			</div>
		</details>
	</div>
</header>

<style>
	.site-header { position: fixed; inset: 10px 0 auto; z-index: 20; pointer-events: none; }
	.site-header__inner { width: min(calc(100% - 48px), 980px); min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-inline: auto; padding: 4px 5px 4px 12px; border: 1px solid var(--glass-line); border-radius: 8px; background: var(--glass-surface); box-shadow: 0 5px 14px rgb(21 21 21 / 5%); backdrop-filter: blur(22px) saturate(150%); pointer-events: auto; }
	.brand { display: inline-flex; align-items: center; }
	.brand__logo { width: 76px; height: 25px; display: block; }
	.desktop-nav, .desktop-actions { display: flex; align-items: center; gap: 20px; }
	.desktop-nav { margin-right: 4px; margin-left: auto; }
	.desktop-nav a, .text-link { color: var(--ink-muted); font-size: 13px; font-weight: 500; transition: color 140ms ease; }
	.desktop-actions .button { min-height: 32px; padding-inline: 11px; font-size: 12px; }
	.desktop-nav a:hover, .text-link:hover { color: var(--ink); }
	.mobile-nav { position: relative; display: none; }
	.mobile-nav summary { color: var(--ink); font-size: 14px; font-weight: 600; list-style: none; cursor: pointer; }
	.mobile-nav summary::-webkit-details-marker { display: none; }
	.mobile-nav__panel { position: absolute; top: calc(100% + 8px); right: 0; width: 220px; display: grid; gap: 2px; padding: 9px; border: 1px solid var(--glass-line); border-radius: var(--radius); background: var(--glass-surface-strong); box-shadow: var(--glass-shadow); backdrop-filter: blur(22px) saturate(150%); }
	.mobile-nav__panel > a:not(.button) { padding: 11px; color: var(--ink-muted); font-size: 14px; font-weight: 500; }
	.mobile-nav__panel .button { margin-top: 4px; }

	@media (prefers-color-scheme: dark) {
		.brand__logo { filter: invert(1); }
		.site-header__inner { box-shadow: 0 5px 18px rgb(0 0 0 / 28%); }
	}

	@media (max-width: 640px) {
		.site-header { inset: 8px 0 auto; }
		.site-header__inner { width: min(calc(100% - 32px), var(--page-width)); min-height: 46px; padding-left: 12px; }
		.desktop-nav, .desktop-actions { display: none; }
		.mobile-nav { display: block; }
	}

	@media (prefers-reduced-motion: reduce) {
		.desktop-nav a, .text-link { transition: none; }
	}

	@media (prefers-reduced-transparency: reduce) {
		.site-header__inner, .mobile-nav__panel { background: var(--surface); backdrop-filter: none; }
	}
</style>

---
import { Image } from 'astro:assets';
import toolsBlue01 from '../assets/images/tools-blue-01.webp';
import toolsFuchsia02 from '../assets/images/tools-fuchsia-02.webp';
import toolsGreen01 from '../assets/images/tools-green-01.webp';
import toolsRed01 from '../assets/images/tools-red-01.webp';
import concreteSculptures from '../assets/images/concrete-sculptures.jpg';
---

<section class="interaction-highlights page-width" aria-labelledby="interaction-heading">
	<div class="interaction-highlights__intro">
		<h2 id="interaction-heading">Small tools that keep the work moving.</h2>
		<p>Quick actions stay close to the canvas, so you can keep sorting, capturing, and moving without losing context.</p>
	</div>
	<div class="interaction-grid">
		<span class="interaction-grid__rule interaction-grid__rule--top" aria-hidden="true"></span>
		<span class="interaction-grid__rule interaction-grid__rule--middle" aria-hidden="true"></span>
		<span class="interaction-grid__rule interaction-grid__rule--lower" aria-hidden="true"></span>
		<span class="interaction-grid__rule interaction-grid__rule--bottom" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--start" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--one" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--two" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--end" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--middle interaction-grid__junction--start" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--middle interaction-grid__junction--one" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--middle interaction-grid__junction--two" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--middle interaction-grid__junction--end" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--lower interaction-grid__junction--start" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--lower interaction-grid__junction--one" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--lower interaction-grid__junction--end" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--start" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--one" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--two" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--end" aria-hidden="true"></span>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Source imports</h3>
				<p>Save an Instagram or X post straight into a collection with media and context intact.</p>
			</div>
			<div class="source-import-preview" role="img" aria-label="An imported social post becoming a canvas reference">
				<svg class="source-import-preview__connector source-import-preview__connector--instagram" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
					<path class="source-import-preview__connector-rail" d="M0 3 C34 4 40 25 100 28"></path>
					<path class="source-import-preview__connector-flow" pathLength="100" d="M0 3 C34 4 40 25 100 28"></path>
					<circle class="source-import-preview__flow-dot" r="3"><animateMotion dur="1.35s" repeatCount="indefinite" path="M0 3 C34 4 40 25 100 28"></animateMotion></circle>
				</svg>
				<svg class="source-import-preview__connector source-import-preview__connector--pinterest" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
					<path class="source-import-preview__connector-rail" d="M0 25 C34 24 40 3 100 0"></path>
					<path class="source-import-preview__connector-flow" pathLength="100" d="M0 25 C34 24 40 3 100 0"></path>
					<circle class="source-import-preview__flow-dot" r="3"><animateMotion dur="1.35s" begin=".3s" repeatCount="indefinite" path="M0 25 C34 24 40 3 100 0"></animateMotion></circle>
				</svg>
				<svg class="source-import-preview__connector source-import-preview__connector--x" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
					<path class="source-import-preview__connector-rail" d="M0 28 C60 25 66 4 100 3"></path>
					<path class="source-import-preview__connector-flow" pathLength="100" d="M0 28 C60 25 66 4 100 3"></path>
					<circle class="source-import-preview__flow-dot" r="3"><animateMotion dur="1.35s" begin=".15s" repeatCount="indefinite" path="M100 3 C66 4 60 25 0 28"></animateMotion></circle>
				</svg>
				<svg class="source-import-preview__connector source-import-preview__connector--dribbble" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
					<path class="source-import-preview__connector-rail" d="M0 0 C60 3 66 24 100 25"></path>
					<path class="source-import-preview__connector-flow" pathLength="100" d="M0 0 C60 3 66 24 100 25"></path>
					<circle class="source-import-preview__flow-dot" r="3"><animateMotion dur="1.35s" begin=".45s" repeatCount="indefinite" path="M100 25 C66 24 60 3 0 0"></animateMotion></circle>
				</svg>
				<span class="source-import-preview__pulse source-import-preview__pulse--instagram" aria-hidden="true"></span>
				<span class="source-import-preview__pulse source-import-preview__pulse--pinterest" aria-hidden="true"></span>
				<span class="source-import-preview__pulse source-import-preview__pulse--x" aria-hidden="true"></span>
				<span class="source-import-preview__pulse source-import-preview__pulse--dribbble" aria-hidden="true"></span>
				<div class="source-import-preview__social source-import-preview__social--instagram">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"></path></svg>
				</div>
				<div class="source-import-preview__social source-import-preview__social--pinterest">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"></path></svg>
				</div>
				<div class="source-import-preview__social source-import-preview__social--x">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"></path></svg>
				</div>
				<div class="source-import-preview__social source-import-preview__social--dribbble">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.384-.438 1.34 3.684 1.887 6.684 1.992 7.308 2.3-1.555 3.936-4.02 4.395-6.87zm-6.115 7.808c-.153-.9-.75-4.032-2.19-7.77l-.066.02c-5.79 2.015-7.86 6.025-8.04 6.4 1.73 1.358 3.92 2.166 6.29 2.166 1.42 0 2.77-.29 4-.814zm-11.62-2.58c.232-.4 3.045-5.055 8.332-6.765.135-.045.27-.084.405-.12-.26-.585-.54-1.167-.832-1.74C7.17 11.775 2.206 11.71 1.756 11.7l-.004.312c0 2.633.998 5.037 2.634 6.855zm-2.42-8.955c.46.008 4.683.026 9.477-1.248-1.698-3.018-3.53-5.558-3.8-5.928-2.868 1.35-5.01 3.99-5.676 7.17zM9.6 2.052c.282.38 2.145 2.914 3.822 6 3.645-1.365 5.19-3.44 5.373-3.702-1.81-1.61-4.19-2.586-6.795-2.586-.825 0-1.63.1-2.4.285zm10.335 3.483c-.218.29-1.935 2.493-5.724 4.04.24.49.47.985.68 1.486.08.18.15.36.22.53 3.41-.43 6.8.26 7.14.33-.02-2.42-.88-4.64-2.31-6.38z"></path></svg>
				</div>
				<div class="source-import-preview__collection">
					<div class="source-import-preview__collection-preview">
						<div class="source-import-preview__asset source-import-preview__asset--one"><Image src={toolsRed01} alt="" /></div>
						<div class="source-import-preview__asset source-import-preview__asset--two"><Image src={toolsFuchsia02} alt="" /></div>
						<div class="source-import-preview__asset source-import-preview__asset--three"><span>Visual notes</span></div>
					</div>
					<div class="source-import-preview__collection-meta"><strong>Inspiration</strong><span>24</span></div>
				</div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Paste to capture</h3>
				<p>Paste an image, URL, or text and Aska turns it into the right kind of asset.</p>
			</div>
			<div class="paste-preview" role="img" aria-label="A focused Aska board receiving pasted image, URL, or text content">
				<div class="paste-preview__surface">
					<div class="paste-preview__gesture" aria-hidden="true"><span>⌘ + V</span></div>
					<div class="paste-preview__payloads">
						<div class="paste-preview__payload paste-preview__payload--image">
							<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="m21 15-5-5L5 21"></path></svg>
							<span>Image</span>
						</div>
						<div class="paste-preview__payload paste-preview__payload--url">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l2.12-2.12a5 5 0 0 0-7.07-7.07L11 4.93"></path><path d="M14 11a5 5 0 0 0-7.07 0L4.81 13.12a5 5 0 0 0 7.07 7.07L13 19.07"></path></svg>
							<span>URL</span>
						</div>
						<div class="paste-preview__payload paste-preview__payload--text">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 13H8"></path><path d="M16 17H8"></path></svg>
							<span>Text</span>
						</div>
					</div>
					<svg class="paste-preview__flow" viewBox="0 0 284 120" aria-hidden="true">
						<path d="M78 20 C112 20 130 45 171 45"></path>
						<path d="M88 63 C116 63 134 48 171 47"></path>
						<path d="M54 107 C104 107 130 54 171 49"></path>
					</svg>
					<div class="paste-preview__inserted">
						<Image src={toolsGreen01} alt="" />
					</div>
				</div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Command palette</h3>
				<p>Search across collections, make folders, and capture a note without leaving the work.</p>
			</div>
			<div class="command-preview" role="img" aria-label="A compact Aska command palette">
				<div class="command-preview__dialog">
					<div class="command-preview__body">
						<div class="command-preview__search">
							<span>Type a command or search...</span>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
						</div>
						<div class="command-preview__list">
							<div class="command-preview__group">Create</div>
							<div class="command-preview__item command-preview__item--active">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
								<span>New note</span>
								<strong>N</strong>
							</div>
							<div class="command-preview__item">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10v6"></path><path d="M9 13h6"></path><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
								<span>New folder</span>
								<strong>F</strong>
							</div>
							<div class="command-preview__item">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h6"></path><path d="M19 2v6"></path><path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5"></path><path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"></path><circle cx="9" cy="9" r="2"></circle></svg>
								<span>Upload images</span>
								<strong>U</strong>
							</div>
							<div class="command-preview__separator"></div>
							<div class="command-preview__group">Navigate</div>
							<div class="command-preview__item">
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg>
								<span>Search all assets</span>
								<strong>/</strong>
							</div>
							<div class="command-preview__item">
								<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path></svg>
								<span>Open Inbox</span>
								<strong>I</strong>
							</div>
						</div>
					</div>
					<div class="command-preview__footer">
						<span><kbd>Esc</kbd> Close</span>
						<span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
						<span><kbd>Enter</kbd> Select</span>
					</div>
				</div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Folders on the canvas</h3>
				<p>Group related material spatially, without losing its place in the larger picture.</p>
			</div>
			<div class="folder-canvas-preview" role="img" aria-label="An Aska canvas with a folder containing references">
				<div class="folder-canvas-preview__grid">
					<div class="folder-canvas-preview__folder">
						<div class="folder-canvas-preview__folder-grid">
							<Image src={toolsRed01} alt="" />
							<Image src={toolsGreen01} alt="" />
							<Image src={toolsBlue01} alt="" />
							<Image src={toolsFuchsia02} alt="" />
						</div>
						<div class="folder-canvas-preview__folder-label"><strong>Material studies</strong><small>24</small></div>
					</div>
					<div class="folder-canvas-preview__bubble">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M3 6.75A1.75 1.75 0 0 1 4.75 5h4.1l2 2h8.4A1.75 1.75 0 0 1 21 8.75v8.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25z"></path>
						</svg>
					</div>
				</div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Global scratchpad</h3>
				<p>Hold a thought in one place, then move it into the collection when it is ready.</p>
			</div>
			<div class="scratchpad-preview" role="img" aria-label="An Aska global scratchpad note">
				<div class="scratchpad-preview__overlay">
					<div class="scratchpad-preview__panel">
						<div class="scratchpad-preview__frame">
							<div class="scratchpad-preview__surface">
								<div class="scratchpad-preview__textarea">Capture to Inbox...</div>
							</div>
							<div class="scratchpad-preview__shortcuts">
								<span class="scratchpad-preview__shortcut scratchpad-preview__shortcut--close"><kbd>Esc</kbd> Close</span>
								<span class="scratchpad-preview__shortcut"><kbd>Shift</kbd><em>+</em><kbd>Enter</kbd> New line</span>
								<span class="scratchpad-preview__shortcut"><kbd>Enter</kbd> Save</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Multi-select actions</h3>
				<p>Select a set of references, then move, arrange, or group them while the canvas stays in view.</p>
			</div>
			<div class="selection-preview" role="img" aria-label="Two selected Aska image assets with a bounding selection box and floating action bar">
				<div class="selection-preview__board">
					<div class="selection-preview__marquee" aria-hidden="true">
						<svg viewBox="0 0 264 166" preserveAspectRatio="none">
							<rect x="0.75" y="0.75" width="262.5" height="164.5" rx="9"></rect>
						</svg>
					</div>
					<div class="selection-preview__card selection-preview__card--image selection-preview__card--selected">
						<Image src={concreteSculptures} alt="" />
					</div>
					<div class="selection-preview__card selection-preview__card--image-two selection-preview__card--selected">
						<Image src={toolsFuchsia02} alt="" />
					</div>
				</div>
				<div class="selection-preview__action-bar">
					<span class="selection-preview__count">2 selected</span>
					<i></i>
					<button aria-label="Move" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M3 17v2a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2"></path></svg></button>
					<button aria-label="Favorite" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"></path></svg></button>
					<button aria-label="Delete" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg></button>
					<i></i>

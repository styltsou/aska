---
import { Image } from 'astro:assets';
import toolsBlue01 from '../assets/images/tools-blue-01.webp';
import toolsFuchsia02 from '../assets/images/tools-fuchsia-02.webp';
import toolsGreen01 from '../assets/images/tools-green-01.webp';
import toolsRed01 from '../assets/images/tools-red-01.webp';
---

<section class="interaction-highlights page-width" aria-labelledby="interaction-heading">
	<div class="interaction-highlights__intro">
		<h2 id="interaction-heading">Small tools that keep the work moving.</h2>
		<p>Quick actions stay close to the canvas, so the archive never interrupts the thought.</p>
	</div>
	<div class="interaction-grid">
		<span class="interaction-grid__rule interaction-grid__rule--top" aria-hidden="true"></span>
		<span class="interaction-grid__rule interaction-grid__rule--bottom" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--start" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--one" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--two" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--top interaction-grid__junction--end" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--start" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--one" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--two" aria-hidden="true"></span>
		<span class="interaction-grid__junction interaction-grid__junction--bottom interaction-grid__junction--end" aria-hidden="true"></span>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Command palette</h3>
				<p>Open collections, make folders, and capture a note without leaving the work.</p>
			</div>
			<div class="command-preview" role="img" aria-label="A compact Aska command palette">
				<div class="command-preview__search">Type a command or search... <kbd>Ctrl K</kbd></div>
				<div class="command-preview__group">Navigate</div>
				<div class="command-preview__item command-preview__item--active"><span>Open Inbox</span><kbd>G I</kbd></div>
				<div class="command-preview__item"><span>Browse collections</span><kbd>G C</kbd></div>
				<div class="command-preview__group">Create</div>
				<div class="command-preview__item"><span>New folder</span><kbd>F</kbd></div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Global scratchpad</h3>
				<p>Hold a thought in one place, then move it into the collection when it is ready.</p>
			</div>
			<div class="scratchpad-preview" role="img" aria-label="An Aska global scratchpad note">
				<div class="scratchpad-preview__bar"><span>Scratchpad</span><span>Saved</span></div>
				<p><strong>Things to return to</strong></p>
				<p>What changes when the archive becomes part of the process?</p>
				<div class="scratchpad-preview__footer"><span>Move to collection</span><span>...</span></div>
			</div>
		</article>
		<article class="interaction-item">
			<div class="interaction-item__copy">
				<h3>Folders on the canvas</h3>
				<p>Group related material spatially, without losing its place in the larger picture.</p>
			</div>
			<div class="folder-canvas-preview" role="img" aria-label="An Aska canvas with a folder containing references">
				<div class="folder-canvas-preview__grid">
					<div class="folder-canvas-preview__folder">
						<div class="folder-canvas-preview__folder-grid">
							<Image src={toolsRed01} alt="" />
							<Image src={toolsGreen01} alt="" />
							<Image src={toolsBlue01} alt="" />
							<Image src={toolsFuchsia02} alt="" />
						</div>
						<div class="folder-canvas-preview__folder-label"><strong>Material studies</strong><small>24</small></div>
					</div>
					<div class="folder-canvas-preview__bubble">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M3 6.75A1.75 1.75 0 0 1 4.75 5h4.1l2 2h8.4A1.75 1.75 0 0 1 21 8.75v8.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25z"></path>
						</svg>
					</div>
				</div>
			</div>
		</article>
	</div>
</section>

<style>
	.interaction-highlights { max-width: 980px; padding-top: 176px; padding-bottom: 132px; }
	.interaction-highlights__intro { max-width: 545px; margin: 0 auto 80px; text-align: center; }
	.interaction-highlights__intro h2 { margin-bottom: 12px; font-size: clamp(27px, 3vw, 39px); line-height: 1.12; }
	.interaction-highlights__intro p { margin: 0; color: var(--ink-muted); font-size: 14px; line-height: 1.55; }
	.interaction-grid { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.interaction-grid::before, .interaction-grid::after { position: absolute; top: -44px; bottom: -44px; z-index: 1; width: 1px; background: linear-gradient(to bottom, transparent, var(--line) 44px, var(--line) calc(100% - 44px), transparent); content: ""; }
	.interaction-grid::before { left: 0; }
	.interaction-grid::after { right: 0; }
	.interaction-grid__rule { position: absolute; right: -24px; left: -24px; z-index: 1; height: 1px; background: linear-gradient(to right, transparent, var(--line) 44px, var(--line) calc(100% - 44px), transparent); }
	.interaction-grid__rule--top { top: 0; }
	.interaction-grid__rule--bottom { bottom: 0; }
	.interaction-grid__junction { position: absolute; z-index: 2; width: 7px; height: 7px; pointer-events: none; }
	.interaction-grid__junction::before, .interaction-grid__junction::after { position: absolute; background: rgb(21 21 21 / 48%); content: ""; }
	.interaction-grid__junction::before { top: 3px; left: 0; width: 7px; height: 1px; }
	.interaction-grid__junction::after { top: 0; left: 3px; width: 1px; height: 7px; }
	.interaction-grid__junction--top { top: 0; transform: translate(-50%, -50%); }
	.interaction-grid__junction--bottom { bottom: 0; transform: translate(-50%, 50%); }
	.interaction-grid__junction--start { left: 0; }
	.interaction-grid__junction--one { left: 33.333%; }
	.interaction-grid__junction--two { left: 66.667%; }
	.interaction-grid__junction--end { left: 100%; }
	.interaction-item { position: relative; min-width: 0; padding: 34px 30px 36px; }
	.interaction-item + .interaction-item::before { position: absolute; top: -44px; bottom: -44px; left: -1px; width: 1px; background: linear-gradient(to bottom, transparent, var(--line) 44px, var(--line) calc(100% - 44px), transparent); content: ""; }
	.interaction-item__copy { min-height: 135px; }
	.interaction-item h3 { margin: 0 0 8px; font-size: 17px; font-weight: 600; }
	.interaction-item p { margin: 0; color: var(--ink-muted); font-size: 13px; line-height: 1.5; }
	.command-preview, .scratchpad-preview, .folder-canvas-preview { position: relative; min-height: 205px; overflow: hidden; border: 1px solid var(--line); border-radius: 6px; background: #fff; box-shadow: 0 2px 7px rgb(21 21 21 / 3%); }
	.command-preview { padding: 8px; }
	.command-preview__search { display: flex; align-items: center; justify-content: space-between; height: 33px; padding: 0 9px; border-bottom: 1px solid var(--line); color: #898982; font-size: 9px; }
	kbd { padding: 2px 4px; border: 1px solid #d8d8d3; border-radius: 3px; background: #f8f8f6; color: #6f6f69; font: inherit; font-size: 8px; }
	.command-preview__group { padding: 10px 8px 4px; color: #999991; font-size: 8px; }
	.command-preview__item { display: flex; align-items: center; justify-content: space-between; padding: 7px 8px; border-radius: 4px; color: #4a4a45; font-size: 10px; }
	.command-preview__item--active { color: #20201e; background: #efefec; }
	.scratchpad-preview { padding: 13px; text-align: left; }
	.scratchpad-preview__bar, .scratchpad-preview__footer { display: flex; justify-content: space-between; color: #8b8b84; font-size: 8px; }
	.scratchpad-preview__bar { padding-bottom: 12px; border-bottom: 1px solid var(--line); }
	.scratchpad-preview > p { margin: 13px 0 0; color: #41413c; font-size: 11px; line-height: 1.45; }
	.scratchpad-preview > p + p { margin-top: 8px; color: #777771; }
	.scratchpad-preview__footer { position: absolute; right: 13px; bottom: 13px; left: 13px; align-items: center; padding-top: 10px; border-top: 1px solid var(--line); }
	.folder-canvas-preview { border: 0; background-color: transparent; background-image: url('/canvas-dots.svg'); box-shadow: none; }
	.folder-canvas-preview__grid { position: absolute; inset: 0; }
	.folder-canvas-preview__folder { position: absolute; top: 7px; left: 50%; z-index: 2; width: 178px; height: 192px; overflow: hidden; border: 1px solid rgb(0 0 0 / 9%); border-radius: 6px; background: #fff; box-shadow: 0 3px 10px rgb(21 21 21 / 5%); transform: translateX(-50%); }
	.folder-canvas-preview__folder-grid { display: grid; width: 100%; height: 178px; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 4px; padding: 6px; }
	.folder-canvas-preview__folder-grid img { display: block; width: 100%; height: 100%; min-width: 0; min-height: 0; border-radius: 2px; object-fit: cover; }
	.folder-canvas-preview__folder-label { position: absolute; right: 1px; bottom: 1px; left: 1px; display: flex; align-items: center; min-height: 29px; gap: 6px; padding: 6px 8px; border-radius: 0 0 5px 5px; background: #fff; color: #464641; font-size: 8px; }
	.folder-canvas-preview__folder-label strong { overflow: hidden; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
	.folder-canvas-preview__folder-label small { margin-left: auto; color: #85857e; }
	.folder-canvas-preview__bubble { position: absolute; top: 0; left: calc(50% - 113px); z-index: 3; display: grid; width: 58px; height: 58px; border: 1px solid rgb(21 21 21 / 9%); border-radius: 50%; background: rgb(255 255 255 / 72%); box-shadow: 0 3px 9px rgb(21 21 21 / 6%); backdrop-filter: blur(14px) saturate(145%); place-items: center; }
	.folder-canvas-preview__bubble svg { width: 23px; height: 23px; fill: none; stroke: #4d4d48; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }


	:global(html[data-theme='dark']) .interaction-grid__junction::before,
	:global(html[data-theme='dark']) .interaction-grid__junction::after { background: rgb(241 243 238 / 46%); }
	:global(html[data-theme='dark']) .command-preview,
	:global(html[data-theme='dark']) .scratchpad-preview { background: var(--surface); box-shadow: 0 2px 8px rgb(0 0 0 / 18%); }
	:global(html[data-theme='dark']) .command-preview__search,
	:global(html[data-theme='dark']) .command-preview__group,
	:global(html[data-theme='dark']) .scratchpad-preview__bar,
	:global(html[data-theme='dark']) .scratchpad-preview__footer { color: var(--ink-muted); }
	:global(html[data-theme='dark']) kbd { border-color: var(--line-strong); background: var(--surface-muted); color: var(--ink-muted); }
	:global(html[data-theme='dark']) .command-preview__item { color: #c5c9c2; }
	:global(html[data-theme='dark']) .command-preview__item--active { color: var(--ink); background: #303530; }
	:global(html[data-theme='dark']) .scratchpad-preview > p { color: #d4d7d1; }
	:global(html[data-theme='dark']) .scratchpad-preview > p + p { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .folder-canvas-preview { background-image: radial-gradient(circle, rgb(241 243 238 / 15%) .6px, transparent .7px); background-size: 24px 24px; }
	:global(html[data-theme='dark']) .folder-canvas-preview__folder { border-color: rgb(255 255 255 / 10%); background: var(--surface); box-shadow: 0 3px 10px rgb(0 0 0 / 24%); }
	:global(html[data-theme='dark']) .folder-canvas-preview__folder-label { color: var(--ink); background: var(--surface); }
	:global(html[data-theme='dark']) .folder-canvas-preview__folder-label small { color: var(--ink-muted); }
	:global(html[data-theme='dark']) .folder-canvas-preview__bubble { border-color: rgb(255 255 255 / 11%); background: rgb(27 30 27 / 76%); box-shadow: 0 3px 10px rgb(0 0 0 / 28%); }
	:global(html[data-theme='dark']) .folder-canvas-preview__bubble svg { stroke: var(--ink); }

	@media (max-width: 820px) {
		.interaction-grid { grid-template-columns: 1fr; }
		.interaction-item + .interaction-item::before { top: 0; right: -24px; bottom: auto; left: -24px; width: auto; height: 1px; background: linear-gradient(to right, transparent, var(--line) 44px, var(--line) calc(100% - 44px), transparent); display: block; }
		.interaction-item + .interaction-item::after { position: absolute; top: 0; right: -3px; left: -3px; z-index: 2; height: 7px; background: linear-gradient(rgb(21 21 21 / 48%), rgb(21 21 21 / 48%)) left center / 7px 1px no-repeat, linear-gradient(rgb(21 21 21 / 48%), rgb(21 21 21 / 48%)) left 3px center / 1px 7px no-repeat, linear-gradient(rgb(21 21 21 / 48%), rgb(21 21 21 / 48%)) right center / 7px 1px no-repeat, linear-gradient(rgb(21 21 21 / 48%), rgb(21 21 21 / 48%)) right 3px center / 1px 7px no-repeat; content: ""; pointer-events: none; transform: translateY(-50%); }
		.interaction-grid__junction--one, .interaction-grid__junction--two { display: none; }
		.interaction-item__copy { min-height: auto; margin-bottom: 24px; }
	}

	:global(html[data-theme=dark]) .interaction-item + .interaction-item::after { background: linear-gradient(rgb(241 243 238 / 46%), rgb(241 243 238 / 46%)) left center / 7px 1px no-repeat, linear-gradient(rgb(241 243 238 / 46%), rgb(241 243 238 / 46%)) left 3px center / 1px 7px no-repeat, linear-gradient(rgb(241 243 238 / 46%), rgb(241 243 238 / 46%)) right center / 7px 1px no-repeat, linear-gradient(rgb(241 243 238 / 46%), rgb(241 243 238 / 46%)) right 3px center / 1px 7px no-repeat; }

	@media (max-width: 640px) {
		.interaction-highlights { padding-top: 126px; padding-bottom: 92px; }
		.interaction-highlights__intro { margin-bottom: 60px; }
		.interaction-grid__rule { right: -16px; left: -16px; }
		.interaction-item + .interaction-item::before { right: -16px; left: -16px; }
		.interaction-item { padding: 28px 18px 32px; }
		.command-preview, .scratchpad-preview, .folder-canvas-preview { min-height: 196px; }
	}
</style>

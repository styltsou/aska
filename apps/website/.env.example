# Base URL for the separately deployed Mnemee application.
PUBLIC_APP_URL=https://app.mnemee.space

# Canonical origin of the marketing site (canonical and Open Graph URLs, sitemap, llms.txt). Defaults to https://mnemee.space.
SITE_URL=https://mnemee.space

# PostHog public project token and matching regional ingestion host. Leave the token empty to disable analytics.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

---
import '../styles/global.css';
import { SmoothScroll } from '../components/SmoothScroll';
import { product } from '../lib/content';

interface Props {
	title?: string;
	description?: string;
	/** Path of the page (for the canonical URL and the markdown alternate). Defaults to the current route. */
	path?: string;
	/** Path of the markdown version of the page, announced to agents and crawlers. */
	markdownPath?: string;
	/** Social preview image, relative to the site root. */
	image?: string;
	imageAlt?: string;
	/** Structured data (schema.org), emitted as JSON-LD. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title = product.name,
	description = product.description,
	path = Astro.url.pathname,
	markdownPath,
	image = '/og-image.png',
	imageAlt = `${product.name}: ${product.tagline}`,
	jsonLd,
	noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={product.keywords.join(', ')} />
		<meta name="author" content={product.name} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
		<link rel="canonical" href={canonical} />
		{markdownPath && <link rel="alternate" type="text/markdown" href={new URL(markdownPath, site).href} title={`${product.name} (Markdown)`} />}
		<link rel="alternate" type="text/plain" href={new URL('/llms.txt', site).href} title="llms.txt" />
		<meta name="theme-color" content="#ffffff" />
		<!-- The SVG icon follows the user's chosen theme (swapped below and by the theme switch); it adapts to the system theme on its own until then. -->
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" id="site-icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={product.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<script is:inline>
			(() => {
				const storageKey = 'mnemee-theme';
				let savedTheme = null;

				try {
					savedTheme = localStorage.getItem(storageKey);
				} catch {
					// Storage can be unavailable in private browsing contexts.
				}

				const theme = savedTheme === 'light' || savedTheme === 'dark'
					? savedTheme
					: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

				document.documentElement.dataset.theme = theme;
				document.getElementById('site-icon')?.setAttribute('href', theme === 'dark' ? '/favicon-dark.svg' : '/favicon-light.svg');
				document.querySelector('meta[name="theme-color"]')?.setAttribute(
					'content',
					theme === 'dark' ? 'oklch(0.145 0 0)' : '#ffffff',
				);
			})();
		</script>
		{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<slot />
		<SmoothScroll client:load />
	</body>
</html>

---
import { HeaderInner } from './HeaderInner';
interface Props {
	loginHref: string;
	signupHref: string;
}

const { loginHref, signupHref } = Astro.props;
---

<header class="site-header" data-surface="hero">
	<HeaderInner client:load loginHref={loginHref} signupHref={signupHref} />
</header>

<script>
	import '../scripts/site-header';
</script>

<style is:global>
	.site-header { --header-surface: var(--surface); position: sticky; top: 0; z-index: 100; background-color: var(--header-surface); }
	.site-header[data-surface='mirror'], .site-header[data-surface='hero'] { --header-surface: transparent; }
	/* Solid left half used in the hero state; it reaches below the bar so the dropped row stays covered. */
	.site-header::before { content: ''; position: absolute; top: 0; left: 0; z-index: -1; width: 50%; height: 76px; background: var(--surface); opacity: 0; pointer-events: none; }
	.site-header__inner { transition: translate 240ms cubic-bezier(.23, 1, .32, 1); }
	.site-header[data-surface='canvas'] { --header-surface: var(--canvas); }
	.site-header[data-surface='footer'] { --header-surface: var(--footer-surface); }
	/* Let the canvas border pass through the narrow sides of the sticky bar. */
	.site-header[data-frame='canvas'] { -webkit-mask-image: linear-gradient(to right, transparent 1px, #000 1px calc(100% - 1px), transparent calc(100% - 1px)); mask-image: linear-gradient(to right, transparent 1px, #000 1px calc(100% - 1px), transparent calc(100% - 1px)); }
	.site-header:has([data-menu-open]) { -webkit-mask-image: none; mask-image: none; }
	.site-header__inner { position: relative; width: min(calc(100% - 48px), 1200px); min-height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-inline: auto; padding: 4px 0; }
	.site-header__row { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 18px; width: 100%; }
	.brand { display: inline-flex; align-items: center; }
	.brand__logo { width: 96px; height: 25px; display: block; }
	.desktop-nav, .desktop-actions { display: flex; align-items: center; gap: 20px; }
	/* Links sit beside the logo; the account buttons sit at the far right, over the hero image at the top of the page. */
	.desktop-nav { margin-right: auto; margin-left: 28px; }
	.desktop-actions { gap: 8px; }
	/*
	 * Over the hero on desktop the navbar spans the full width with equal 28px gutters, so the account buttons sit in the image
	 * panel's top-right corner with 12px padding on both sides (panel inset 16px + 12px). The row also drops 20px (bar centre
	 * 26px + 20px = 46px, 36px button top 28px = 16px inset + 12px). Once the hero has passed it eases back up and contracts to the
	 * page width.
	 */
	@media (min-width: 1024px) {
		.site-header__inner { transition: translate 320ms cubic-bezier(.23, 1, .32, 1), width 320ms cubic-bezier(.23, 1, .32, 1); }
		/* Only without the pinned hero (reduced motion, short windows), where the copy scrolls under the bar. */
		.site-header[data-surface='hero']:not([data-morph])::before { opacity: 1; }
		.site-header[data-surface='hero'] .site-header__inner { width: calc(100% - 56px); translate: 0 20px; }
		/*
		 * With the pinned hero the morph follows the scroll. --hero-drop (1 → 0) lifts the row as the image drops below the bar;
		 * --hero-w (0 → 1) contracts it to the page width only as the hero ends, so it stays aligned with the full-width image until then.
		 */
		.site-header[data-morph] .site-header__inner { --hero-row-width: calc(100% - 32px - 24px * var(--hero-drop, 0)); width: calc(var(--hero-row-width) + (min(100% - 48px, 1200px) - var(--hero-row-width)) * var(--hero-w, 1)); translate: 0 calc(20px * var(--hero-drop, 0)); transition: none; }
	}
	.desktop-nav a, .text-link { color: var(--ink-muted); font-size: 13px; font-weight: 500; transition: color 140ms ease; }
	.desktop-nav a[aria-current='location'], .mobile-menu-nav a[aria-current='location'] { color: var(--ink); }

	.mobile-menu-toggle, .mobile-menu-content { display: none; }

	@media (hover: hover) {
		.desktop-nav a:hover, .text-link:hover { color: var(--ink); }
		.mobile-menu-nav a:hover { color: var(--ink); }
	}

	@media (hover: none) {
		.mobile-menu-nav a:active, .text-link:active { color: var(--ink); }
	}


	html[data-theme='dark'] .brand__logo { filter: invert(1); }

	@media (max-width: 640px) {
		html.has-mobile-menu { overflow: hidden; }
		.site-header { top: 0; z-index: 100; }
		.site-header__inner { position: relative; z-index: 1; width: calc(100% - 32px); height: 52px; min-height: 0; margin-inline: auto; padding: 4px 0; overflow: visible; display: flex; flex-direction: column; align-items: stretch; }
		.site-header:has([data-menu-open]) { --header-surface: var(--surface); background-image: none !important; }
		.site-header__row { z-index: 2; flex-shrink: 0; gap: 0; pointer-events: auto; }
		.mobile-menu-toggle, .mobile-menu-content { display: flex; }
		.desktop-nav, .desktop-actions { display: none; }
		.mobile-menu-toggle { width: 38px; height: 38px; flex: 0 0 38px; padding: 0; border: 0; border-radius: 8px; color: var(--ink); background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 140ms ease; }
		.mobile-menu-toggle__icon { position: relative; width: 21px; height: 14px; display: block; }
		.mobile-menu-toggle__icon span { position: absolute; top: 50%; right: 0; height: 2px; border-radius: 2px; background: currentColor; transform-origin: center; transition: width 240ms cubic-bezier(.23, 1, .32, 1), transform 240ms cubic-bezier(.23, 1, .32, 1); }
		.mobile-menu-toggle__icon span:first-child { width: 21px; transform: translateY(-3px); }
		.mobile-menu-toggle__icon span:last-child { width: 13px; transform: translateY(3px); }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span { width: 19px; }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span:first-child { transform: translateY(-1px) rotate(45deg); }
		.mobile-menu-toggle[aria-expanded="true"] .mobile-menu-toggle__icon span:last-child { transform: translateY(-1px) rotate(-45deg); }

		.mobile-menu-content { position: fixed; z-index: 1; top: 0; left: 0; right: 0; bottom: 0; width: 100%; min-height: 0; overflow-y: auto; flex-direction: column; justify-content: space-between; padding: 86px 24px max(24px, env(safe-area-inset-bottom)); background: var(--surface); opacity: 0; visibility: hidden; clip-path: inset(7px 16px calc(100% - 45px) calc(100% - 54px) round 12px); transition: opacity 260ms cubic-bezier(.32, .72, 0, 1), clip-path 260ms cubic-bezier(.32, .72, 0, 1), visibility 0s linear 260ms; pointer-events: none; }
		@supports ((-webkit-backdrop-filter: blur(24px)) or (backdrop-filter: blur(24px))) {
			.mobile-menu-content { background: color-mix(in srgb, var(--glass-surface-strong) 94%, transparent); -webkit-backdrop-filter: blur(24px) saturate(1.2); backdrop-filter: blur(24px) saturate(1.2); }
		}
		.site-header__inner[data-menu-open] .mobile-menu-content { opacity: 1; visibility: visible; clip-path: inset(0 round 0); transition: opacity 260ms cubic-bezier(.32, .72, 0, 1), clip-path 260ms cubic-bezier(.32, .72, 0, 1), visibility 0s; pointer-events: auto; }
		.mobile-menu-nav { display: grid; width: 100%; align-content: center; justify-items: stretch; flex: 1; gap: 14px; }
		.mobile-menu-nav a { display: flex; width: 100%; min-height: 50px; align-items: center; justify-content: flex-start; padding: 0 2px; text-align: left; font-size: clamp(30px, 10vw, 44px); font-weight: 560; line-height: 1; color: var(--ink-muted); transition: color 140ms ease, padding 140ms ease; }
		.mobile-menu-footer { display: grid; width: 100%; grid-template-columns: 1fr; gap: 10px; padding-top: 20px; }
		.mobile-menu-footer .app-button { width: 100%; height: 44px; font-size: 14px; }
	}

	@media (hover: hover) and (max-width: 640px) {
		.mobile-menu-toggle:hover { background: var(--surface-muted); }
		html[data-theme=dark] .mobile-menu-toggle:hover { background: rgb(255 255 255 / 8%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__inner { transition: none; }
		.site-header, .mobile-menu-content, .mobile-menu-footer, .desktop-nav a, .text-link, .mobile-menu-nav a, .mobile-menu-toggle, .mobile-menu-toggle__icon span { transition: none; }
		.mobile-menu-content, .site-header__inner[data-menu-open] .mobile-menu-content { clip-path: none; transition: opacity 120ms ease, visibility 0s linear 120ms; }
		.site-header__inner[data-menu-open] .mobile-menu-content { transition-delay: 0s; }
	}

</style>

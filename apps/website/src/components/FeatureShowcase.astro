---
import { Image } from 'astro:assets';
import '../styles/feature-showcase.css';
import blueRedWall from '../assets/images/blue-red-wall.jpg';
import curvedArchitecture from '../assets/images/curved-architecture.jpg';
import brutalistShadows from '../assets/images/brutalist-shadows.jpg';
import concreteSculptures from '../assets/images/concrete-sculptures.jpg';
import greenAbstract02 from '../assets/images/green-abstract-02.webp';
import greenAbstract03 from '../assets/images/green-abstract-03.webp';
import greenAbstract05 from '../assets/images/green-abstract-05.webp';
import greenAbstract07 from '../assets/images/green-abstract-07.webp';
import heroGreen01 from '../assets/images/hero-green-01.webp';
import heroGreen03 from '../assets/images/hero-green-03.webp';
import heroGreen04 from '../assets/images/hero-green-04.webp';
import heroBlue01 from '../assets/images/hero-blue-01.webp';
import heroBlue02 from '../assets/images/hero-blue-02.webp';
import heroBlue03 from '../assets/images/hero-blue-03.webp';
import heroBlue04 from '../assets/images/hero-blue-04.webp';
import heroBlue05 from '../assets/images/hero-blue-05.webp';
import heroRed01 from '../assets/images/hero-red-01.webp';
import heroRed02 from '../assets/images/hero-red-02.webp';
import heroRed03 from '../assets/images/hero-red-03.webp';
import heroRed04 from '../assets/images/hero-red-04.webp';
import heroRed05 from '../assets/images/hero-red-05.webp';

const thumb = { width: 64, densities: [1, 2], quality: 74, alt: '' } as const;
const tile = { width: 200, densities: [1, 2], quality: 76, alt: '' } as const;

// The palette's results: an image, a note, then more images, as the app lists them.
const searchResults = [
	{ image: curvedArchitecture, label: 'Curved concrete stair', detail: 'Studio archive', kind: 'Image' },
	{ image: brutalistShadows, label: 'Brutalist shadows at noon', detail: 'Material library', kind: 'Image' },
	{ note: true, label: 'Light studies', detail: 'Soft light reads flat on raw concrete, so…', kind: 'Note' },
	{ image: blueRedWall, label: 'Painted wall, late light', detail: 'Spring campaign', kind: 'Image' },
	{ image: concreteSculptures, label: 'Concrete sculptures', detail: 'Studio archive', kind: 'Image' },
];
// The filter bar's eight preset colours (apps/web/src/components/filter-bar).
const filterColors = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#3b82f6', '#a855f7', '#ec4899', '#64748b'];
// What each colour the demo picks finds: three masonry columns and a match count.
const colorResults = [
	{ color: '#22c55e', count: 12, columns: [[greenAbstract05, heroGreen03], [heroGreen01, greenAbstract02], [greenAbstract07, greenAbstract03, heroGreen04]] },
	{ color: '#3b82f6', count: 9, columns: [[heroBlue01, heroBlue04], [heroBlue02, heroBlue05], [heroBlue03, blueRedWall]] },
	{ color: '#ef4444', count: 7, columns: [[heroRed01, heroRed04], [heroRed02, heroRed05], [heroRed03]] },
];
const pointer = 'M5 3.2v15.6l4.2-4 2.8 6.3 2.6-1.1-2.8-6.2h5.9z';
---

<section id="workflow" class="features page-width scroll-anchor" aria-label="Mnemee features" data-header-surface="canvas">
	<article class="feature feature--semantic">
		<div class="feature__copy">
			<div class="feature__eyebrow"><span>Semantic search</span><span class="feature__planned">Coming soon</span></div>
			<h2>Find the idea, even when you can't name the file.</h2>
			<p>Search across a collection using the meaning and visual qualities of what you've saved.</p>
		</div>
		<!-- The app's command palette (components/command-palette) in search mode. -->
		<div class="feature-visual semantic-visual" role="img" aria-label="Concept preview of a semantic search for architectural references" data-demo="search">
			<!-- The app's top bar on a collection board: sidebar toggle, breadcrumb, and the View menu. -->
			<div class="mock app-topbar app-topbar--board" aria-hidden="true">
				<span class="app-topbar__toggle"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></svg></span>
				<span class="app-topbar__crumb app-topbar__crumb--parent">Collections</span>
				<span class="app-topbar__sep"></span>
				<span class="app-topbar__crumb">Material library</span>
				<span class="app-topbar__view">View <svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></span>
			</div>
			<!-- The board (rounded-xl bg-card) behind the palette, under the dialog's dim-and-blur backdrop. -->
			<div class="board-frame" aria-hidden="true">
			<div class="mock search-board">
				<!-- Canvas units, as on the app's board (cards 280 wide), shown zoomed out. -->
				<div class="board-card board-card--image" style="left: 40px; top: 56px; width: 280px; height: 350px;"><Image src={curvedArchitecture} {...tile} /></div>
				<div class="board-card board-card--image" style="left: 40px; top: 430px; width: 280px; height: 210px;"><Image src={heroGreen03} {...tile} /></div>
				<div class="board-card board-card--note" style="left: 344px; top: 24px; width: 280px;"><strong>Light studies</strong><span>Soft light reads flat on raw concrete, so keep one hard shadow in every frame.</span><span>Pair it with one saturated accent, never two.</span></div>
				<div class="board-card board-card--image" style="left: 344px; top: 236px; width: 280px; height: 210px;"><Image src={brutalistShadows} {...tile} /></div>
				<div class="board-card board-card--color" style="left: 648px; top: 88px; width: 280px;"><i style="background: #c8643b;"></i><span>Clay <em>#C8643B</em></span></div>
				<div class="board-card board-card--image" style="left: 648px; top: 444px; width: 280px; height: 210px;"><Image src={blueRedWall} {...tile} /></div>
				<div class="board-card board-card--image" style="left: 952px; top: 40px; width: 280px; height: 350px;"><Image src={greenAbstract05} {...tile} /></div>
				<div class="board-text" style="left: 952px; top: 430px;">Material board</div>
				<div class="board-card board-card--image" style="left: 1256px; top: 120px; width: 280px; height: 350px;"><Image src={heroGreen01} {...tile} /></div>
			</div>
			<!-- The canvas's action rail stays at screen size, bottom centre of the board. -->
			<div class="board-rail"><span></span><span></span><span></span><span></span><i></i><span></span><span></span><i></i><span></span></div>
			</div>
			<div class="palette-backdrop" aria-hidden="true"></div>
			<div class="mock palette" aria-hidden="true">
				<div class="palette__body">
				<div class="palette__input">
					<svg class="mock-icon mock-icon--sm palette__search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
					<span data-query>soft light on concrete</span><i class="mock-caret"></i><span class="palette__placeholder" data-placeholder hidden>Search notes, images, links, colors…</span>
				</div>
				<div class="palette__list" data-results>
					<div class="palette__heading">Results</div>
					{searchResults.map((result, index) => (
						<div class:list={['palette__item', index === 0 && 'palette__item--selected']} data-result>
							{result.note ? (
								<span class="palette__tile palette__tile--note"><svg class="mock-icon" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" /></svg></span>
							) : (
								<span class="palette__tile"><Image src={result.image!} {...thumb} /></span>
							)}
							<span class="palette__text"><span class="palette__label">{result.label}</span><span class="palette__detail">{result.detail}</span></span>
							<span class="palette__kind">{result.kind}</span>
						</div>
					))}
				</div>
				</div>
				<div class="palette__footer">
					<span><kbd>Tab</kbd> for actions</span>
					<span class="palette__footer-end"><kbd>↑</kbd><kbd data-key-down>↓</kbd> to navigate</span>
					<span><kbd data-key-enter>↵</kbd> to select</span>
				</div>
			</div>
		</div>
	</article>

	<article id="color-search" class="feature feature--color scroll-anchor">
		<div class="feature__copy">
			<div class="feature__eyebrow"><span>Color search</span></div>
			<h2>Follow a color back to the image.</h2>
			<p>Pick a color to find matching images in your Inbox or collection.</p>
		</div>
		<!-- The Inbox board with the app's colour filter bar floating over the masonry grid. -->
		<div class="feature-visual color-visual" role="img" aria-label="Color search in the Inbox, picking green, blue and red in turn" data-demo="color">
			<div class="mock inbox" aria-hidden="true" data-mock>
				<!-- The app's top bar (app-header): sidebar toggle, breadcrumb, and the Inbox's grid density switch. -->
				<div class="app-topbar">
					<span class="app-topbar__toggle"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></svg></span>
					<span class="app-topbar__crumb">Inbox</span>
					<span class="density"><span>Spacious</span><span class="is-active">Balanced</span><span>Compact</span></span>
				</div>
				<div class="inbox__board">
				<div class="filter-bar">
					<div class="island filter-bar__type">Color <svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></div>
					<div class="island filter-bar__colors">
						<span class="filter-bar__add"><svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="M12 5v14" /></svg></span>
						<span class="filter-bar__sep"></span>
						<span class="filter-bar__swatches">
							{filterColors.map((color) => <i class:list={[color === '#22c55e' && 'is-active']} data-swatch={color} style={`background-color: ${color}`}></i>)}
						</span>
					</div>
					<div class="island filter-bar__status"><span data-count>12</span>&nbsp;matches</div>
					<div class="island filter-bar__clear"><svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></div>
				</div>
				<div class="masonry-stack">
					{colorResults.map((result, index) => (
						<div class:list={['masonry', index === 0 && 'is-shown']} data-results-for={result.color} data-count-for={result.count}>
							{result.columns.map((column) => (
								<div class="masonry__column">{column.map((image) => <div class="masonry__card"><Image src={image} {...tile} /></div>)}</div>
							))}
						</div>
					))}
				</div>
				</div>
				<svg class="mock-cursor" data-cursor viewBox="0 0 24 24"><path d={pointer} /></svg>
			</div>
		</div>
	</article>

	<article class="feature feature--notes">
		<div class="feature__copy">
			<div class="feature__eyebrow"><span>AI writing</span></div>
			<h2>Make more of the thoughts you save.</h2>
			<p>Ask AI to help write or refine a passage, right where your ideas live.</p>
		</div>
		<!-- The note view and the agent's prompt (board/note-editor/agent). -->
		<div class="feature-visual note-visual" role="img" aria-label="Opening AI on an empty line with the space bar and generating formatted text" data-demo="note">
			<div class="mock note-window" aria-hidden="true" data-mock>
				<div class="note-window__header">
					<div class="note-window__group">
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M15 3v18" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon mock-icon--sm" viewBox="0 0 24 24"><path d="M4 14h6v6" /><path d="M20 10h-6V4" /><path d="m14 10 7-7" /><path d="m3 21 7-7" /></svg></span>
					</div>
					<div class="note-window__group">
						<span class="note-window__status" data-save-status>Edited 2m ago</span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><path d="m9 11-6 6v3h9l3-3" /><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg></span>
					</div>
				</div>
				<div class="note-window__page">
					<div class="note-editor__title">Entrance study</div>
					<div class="note-editor__body">
						<p>The curve softens the space, and the light does most of the work in the morning.</p>
						<div class="note-editor__passage">
							<span class="agent-rail" data-rail></span>
							<p class="note-editor__empty" data-empty><span data-hint>Press space for AI or @ for mentions…</span></p>
							<p class="note-editor__draft" data-draft-row hidden><span data-draft></span></p>
							<div class="agent-prompt" data-prompt data-phase="prompt" hidden>
								<div class="agent-prompt__status"><span class="agent-shimmer">Writing…</span><span class="agent-prompt__ghost">Stop <kbd>Esc</kbd></span></div>
								<div class="agent-prompt__review">
									<span class="agent-prompt__icon-button"><svg class="mock-icon mock-icon--sm" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg></span>
									<span class="agent-button agent-button--secondary">Discard</span>
									<span class="agent-button agent-button--primary" data-keep>Keep</span>
								</div>
								<div class="agent-prompt__input">
									<span data-instruction>Develop the entrance concept</span><i class="mock-caret"></i>
									<span class="agent-prompt__send" data-send><svg class="mock-icon" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg></span>
								</div>
								<div class="agent-prompt__actions"><span>Continue writing</span><span>Summarize</span><span>Outline</span><span>Action items</span></div>
							</div>
						</div>
					</div>
				</div>
				<svg class="mock-cursor" data-cursor viewBox="0 0 24 24"><path d={pointer} /></svg>
			</div>
		</div>
	</article>
</section>

<script>
	/*
	 * Each bento mock-up plays a short loop of the app in use while it's on screen. Time only runs while the panel is
	 * visible (and the tab is shown), so the loops pause off screen. With reduced motion the panels stay as static
	 * screenshots (the markup's default state).
	 */
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
	const scrollVisuals = Array.from(document.querySelectorAll<HTMLElement>('.feature-visual'));
	let scrollFrame = 0;
	const updateScrollVisuals = () => {
		scrollFrame = 0;
		const height = window.innerHeight;
		for (const visual of scrollVisuals) {
			// Remove the previous translation from the measurement to avoid feeding motion back into progress.
			const previousOffset = Number.parseFloat(visual.style.translate) || 0;
			const top = visual.getBoundingClientRect().top - previousOffset;
			const progress = Math.max(0, Math.min(1, (height - top) / (height * .45)));
			const offset = (1 - progress) * 48;
			if (motionPreference.matches) visual.style.removeProperty('translate');
			else visual.style.translate = `${offset}px ${offset}px`;
		}
	};
	const scheduleScrollVisuals = () => {
		if (!scrollFrame) scrollFrame = requestAnimationFrame(updateScrollVisuals);
	};
	window.addEventListener('scroll', scheduleScrollVisuals, { passive: true });
	window.addEventListener('resize', scheduleScrollVisuals);
	motionPreference.addEventListener('change', scheduleScrollVisuals);
	updateScrollVisuals();
	document.addEventListener('astro:before-swap', () => {
		window.removeEventListener('scroll', scheduleScrollVisuals);
		window.removeEventListener('resize', scheduleScrollVisuals);
		motionPreference.removeEventListener('change', scheduleScrollVisuals);
		cancelAnimationFrame(scrollFrame);
	}, { once: true });
	const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
	const easeInOut = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2;

	type Point = { x: number; y: number };

	function startDemo(root: HTMLElement, run: (wait: (ms: number) => Promise<void>) => Promise<void>) {
		let visible = false;
		new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; }, { threshold: .35 }).observe(root);
		// Waits `ms` of on-screen time.
		const wait = async (ms: number) => {
			let left = ms;
			while (left > 0) {
				await sleep(50);
				if (visible && !document.hidden) left -= 50;
			}
		};
		void (async () => {
			for (;;) await run(wait);
		})();
	}

	// Moves a demo cursor (inside a scaled mock) to an element's centre, in the mock's own coordinates.
	function cursorMover(mock: HTMLElement, cursor: SVGElement) {
		let at: Point = { x: mock.offsetWidth + 40, y: mock.offsetHeight * .7 };
		const centreOf = (el: Element): Point => {
			const m = mock.getBoundingClientRect();
			const r = el.getBoundingClientRect();
			const k = m.width / mock.offsetWidth || 1;
			return { x: (r.left + r.width / 2 - m.left) / k, y: (r.top + r.height / 2 - m.top) / k };
		};
		const place = (p: Point, pressed = false) => {
			cursor.style.transform = `translate(${p.x.toFixed(1)}px, ${p.y.toFixed(1)}px) scale(${pressed ? .86 : 1})`;
		};
		place(at);
		return {
			async moveTo(target: Element | Point, wait: (ms: number) => Promise<void>, duration = 520) {
				const to = target instanceof Element ? centreOf(target) : target;
				const from = at;
				const steps = Math.max(1, Math.round(duration / 50));
				for (let i = 1; i <= steps; i++) {
					await wait(50);
					const t = easeInOut(i / steps);
					place({ x: from.x + (to.x - from.x) * t, y: from.y + (to.y - from.y) * t });
				}
				at = to;
			},
			async click(wait: (ms: number) => Promise<void>) {
				place(at, true);
				await wait(120);
				place(at);
			},
			show(on: boolean) { cursor.style.opacity = on ? '1' : '0'; },
			park() { at = { x: mock.offsetWidth + 40, y: mock.offsetHeight * .7 }; place(at); },
		};
	}

	async function type(el: HTMLElement, text: string, wait: (ms: number) => Promise<void>, perChar = 55) {
		for (let i = 1; i <= text.length; i++) {
			el.textContent = text.slice(0, i);
			await wait(perChar);
		}
	}

	if (!reduced) {
		// 1. Search: type the query, results come in, the selection steps down with the arrow key, then Enter.
		const search = document.querySelector<HTMLElement>('[data-demo="search"]');
		const query = search?.querySelector<HTMLElement>('[data-query]');
		const placeholder = search?.querySelector<HTMLElement>('[data-placeholder]');
		const resultsList = search?.querySelector<HTMLElement>('[data-results]');
		const results = Array.from(search?.querySelectorAll<HTMLElement>('[data-result]') ?? []);
		const keyDown = search?.querySelector<HTMLElement>('[data-key-down]');
		const keyEnter = search?.querySelector<HTMLElement>('[data-key-enter]');
		if (search && query && placeholder && resultsList && results.length && keyDown && keyEnter) {
			const QUERY = query.textContent ?? '';
			const select = (index: number) => results.forEach((el, i) => el.classList.toggle('palette__item--selected', i === index));
			const press = async (key: HTMLElement, wait: (ms: number) => Promise<void>) => {
				key.classList.add('is-pressed');
				await wait(140);
				key.classList.remove('is-pressed');
			};
			startDemo(search, async (wait) => {
				query.textContent = '';
				placeholder.hidden = false;
				resultsList.classList.add('is-empty');
				select(-1);
				await wait(700);
				placeholder.hidden = true;
				await type(query, QUERY, wait, 60);
				await wait(250);
				resultsList.classList.remove('is-empty');
				select(0);
				await wait(1100);
				for (const index of [1, 2]) {
					await press(keyDown, wait);
					select(index);
					await wait(900);
				}
				await press(keyEnter, wait);
				await wait(1600);
			});
		}

		// 2. Colour: the cursor picks green, blue, then red; the count and the grid follow each pick.
		const color = document.querySelector<HTMLElement>('[data-demo="color"]');
		const colorMock = color?.querySelector<HTMLElement>('[data-mock]');
		const colorCursor = color?.querySelector<SVGElement>('[data-cursor]');
		const count = color?.querySelector<HTMLElement>('[data-count]');
		const grids = Array.from(color?.querySelectorAll<HTMLElement>('[data-results-for]') ?? []);
		if (color && colorMock && colorCursor && count && grids.length) {
			const cursor = cursorMover(colorMock, colorCursor);
			const swatch = (hex: string) => color.querySelector<HTMLElement>(`[data-swatch="${hex}"]`);
			const pick = (hex: string) => {
				color.querySelectorAll('[data-swatch]').forEach((el) => el.classList.toggle('is-active', el.getAttribute('data-swatch') === hex));
				const grid = grids.find((g) => g.dataset.resultsFor === hex);
				grids.forEach((g) => g.classList.toggle('is-shown', g === grid));
				count.textContent = grid?.dataset.countFor ?? '0';
			};
			startDemo(color, async (wait) => {
				cursor.show(false);
				await wait(200);
				cursor.park();
				await wait(100);
				cursor.show(true);
				await wait(500);
				for (const grid of grids.slice(1).concat(grids[0])) {
					const target = swatch(grid.dataset.resultsFor ?? '');
					if (!target) continue;
					await cursor.moveTo(target, wait, 620);
					await wait(150);
					await cursor.click(wait);
					pick(grid.dataset.resultsFor ?? '');
					await wait(1800);
				}
				await cursor.moveTo({ x: colorMock.offsetWidth + 40, y: colorMock.offsetHeight * .6 }, wait, 600);
				await wait(600);
			});
		}

		// 3. Note: open the agent from the empty line's placeholder, generate formatted text, then keep it.
		const note = document.querySelector<HTMLElement>('[data-demo="note"]');
		const noteMock = note?.querySelector<HTMLElement>('[data-mock]');
		const noteCursor = note?.querySelector<SVGElement>('[data-cursor]');
		const prompt = note?.querySelector<HTMLElement>('[data-prompt]');
		const instruction = note?.querySelector<HTMLElement>('[data-instruction]');
		const send = note?.querySelector<HTMLElement>('[data-send]');
		const keep = note?.querySelector<HTMLElement>('[data-keep]');
		const empty = note?.querySelector<HTMLElement>('[data-empty]');
		const hint = note?.querySelector<HTMLElement>('[data-hint]');
		const draftRow = note?.querySelector<HTMLElement>('[data-draft-row]');
		const draft = note?.querySelector<HTMLElement>('[data-draft]');
		const rail = note?.querySelector<HTMLElement>('[data-rail]');
		const saveStatus = note?.querySelector<HTMLElement>('[data-save-status]');
		if (note && noteMock && noteCursor && prompt && instruction && send && keep && empty && hint && draftRow && draft && rail && saveStatus) {
			const cursor = cursorMover(noteMock, noteCursor);
			const INSTRUCTION = instruction.textContent ?? '';
			const REWRITE = [
				{ text: 'Let the ' },
				{ text: 'rough concrete', tag: 'strong' },
				{ text: ' and polished floor create a ' },
				{ text: 'deliberate contrast', tag: 'em' },
				{ text: '. Keep the surfaces honest: let the light reveal their textures, while a quieter palette gives the entrance room to breathe. Use the changing daylight to bring warmth and depth to the space.' },
			] as const;
			startDemo(note, async (wait) => {
				empty.hidden = false;
				hint.hidden = false;
				draftRow.hidden = true;
				draft.textContent = '';
				prompt.hidden = true;
				prompt.dataset.phase = 'prompt';
				instruction.textContent = '';
				rail.classList.remove('is-on', 'is-streaming');
				saveStatus.textContent = 'Edited 2m ago';
				cursor.park();
				cursor.show(false);
				await wait(900);
				empty.hidden = true;
				prompt.hidden = false;
				cursor.show(true);
				await cursor.moveTo({ x: noteMock.offsetWidth * .9, y: noteMock.offsetHeight * .62 }, wait, 500);
				await wait(400);
				await type(instruction, INSTRUCTION, wait, 50);
				await wait(200);
				await cursor.moveTo(send, wait, 480);
				await wait(120);
				await cursor.click(wait);
				// Stream the generated draft into the empty paragraph.
				prompt.dataset.phase = 'streaming';
				rail.classList.add('is-on', 'is-streaming');
				await cursor.moveTo({ x: noteMock.offsetWidth * .92, y: noteMock.offsetHeight * .5 }, wait, 500);
				draftRow.hidden = false;
				for (const part of REWRITE) {
					const container = 'tag' in part ? document.createElement(part.tag) : draft;
					if (container !== draft) draft.append(container);
					for (const chunk of part.text.match(/\S+\s*|\s+/g) ?? []) {
						container.append(document.createTextNode(chunk));
						await wait(50);
					}
				}
				// Review: Retry / Discard / Keep, with the rail still marking the draft.
				rail.classList.remove('is-streaming');
				prompt.dataset.phase = 'review';
				instruction.textContent = '';
				await wait(800);
				await cursor.moveTo(keep, wait, 520);
				await wait(150);
				await cursor.click(wait);
				prompt.hidden = true;
				rail.classList.remove('is-on');
				saveStatus.textContent = 'Saving…';
				await cursor.moveTo({ x: noteMock.offsetWidth + 40, y: noteMock.offsetHeight * .8 }, wait, 600);
				await wait(500);
				saveStatus.textContent = 'Edited just now';
				await wait(800);
			});
		}
	}
</script>

---
import { Image } from 'astro:assets';
import '../styles/feature-showcase.css';
import { boardImages, colorResults, filterColors, pointer, searchResults, thumb, tile } from '../data/feature-showcase';
---

<section id="workflow" class="features page-width scroll-anchor" aria-label="Mnemee features" data-header-surface="canvas">
	<article class="feature feature--semantic">
		<div class="feature__aura" aria-hidden="true"></div>
		<div class="feature__copy">
		<div class="feature__eyebrow"><span>Semantic search</span><span class="coming-soon-pill">Coming soon</span></div>
			<h2>Find the idea, even when you can't name the file.</h2>
			<p>Search across a collection using the meaning and visual qualities of what you've saved.</p>
		</div>
		<!-- The app's command palette (components/command-palette) in search mode. -->
		<div class="feature-visual semantic-visual" role="img" aria-label="Concept preview of a semantic search for architectural references" data-demo="search">
			<!-- The app's top bar on a collection board: sidebar toggle, breadcrumb, and the View menu. -->
			<div class="mock app-topbar app-topbar--board" aria-hidden="true">
				<span class="app-topbar__toggle"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></svg></span>
				<span class="app-topbar__crumb app-topbar__crumb--parent">Collections</span>
				<span class="app-topbar__sep"></span>
				<span class="app-topbar__crumb">Material library</span>
				<span class="app-topbar__view">View <svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></span>
			</div>
			<!-- The board (rounded-xl bg-card) behind the palette, under the dialog's dim-and-blur backdrop. -->
			<div class="board-frame" aria-hidden="true">
			<div class="mock search-board">
				<!-- Canvas units, as on the app's board (cards 280 wide), shown zoomed out. -->
				<div class="board-card board-card--image" style="left: 40px; top: 56px; width: 280px; height: 350px;"><Image src={boardImages.stair} {...tile} /></div>
				<div class="board-card board-card--image" style="left: 40px; top: 430px; width: 280px; height: 210px;"><Image src={boardImages.leaf} {...tile} /></div>
				<div class="board-card board-card--note" style="left: 344px; top: 24px; width: 280px;"><strong>Light studies</strong><span>Soft light reads flat on raw concrete, so keep one hard shadow in every frame.</span><span>Pair it with one saturated accent, never two.</span></div>
				<div class="board-card board-card--image" style="left: 344px; top: 236px; width: 280px; height: 210px;"><Image src={boardImages.shadows} {...tile} /></div>
				<div class="board-card board-card--color" style="left: 648px; top: 88px; width: 280px;"><i style="background: #c8643b;"></i><span>Clay <em>#C8643B</em></span></div>
				<div class="board-card board-card--image" style="left: 648px; top: 444px; width: 280px; height: 210px;"><Image src={boardImages.wall} {...tile} /></div>
				<div class="board-card board-card--image" style="left: 952px; top: 40px; width: 280px; height: 350px;"><Image src={boardImages.green} {...tile} /></div>
				<div class="board-text" style="left: 952px; top: 430px;">Material board</div>
				<div class="board-card board-card--image" style="left: 1256px; top: 120px; width: 280px; height: 350px;"><Image src={boardImages.mossy} {...tile} /></div>
			</div>
			<!-- The canvas's action rail stays at screen size, bottom centre of the board. -->
			<div class="board-rail"><span></span><span></span><span></span><span></span><i></i><span></span><span></span><i></i><span></span></div>
			</div>
			<div class="palette-backdrop" aria-hidden="true"></div>
			<div class="mock palette" aria-hidden="true">
				<div class="palette__body">
				<div class="palette__input">
					<svg class="mock-icon mock-icon--sm palette__search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
					<span data-query>soft light on concrete</span><i class="mock-caret"></i><span class="palette__placeholder" data-placeholder hidden>Search notes, images, links, colors…</span>
				</div>
				<div class="palette__list" data-results>
					<div class="palette__heading">Results</div>
					{searchResults.map((result, index) => (
						<div class:list={['palette__item', index === 0 && 'palette__item--selected']} data-result>
							{result.note ? (
								<span class="palette__tile palette__tile--note"><svg class="mock-icon" viewBox="0 0 24 24"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" /></svg></span>
							) : (
								<span class="palette__tile"><Image src={result.image!} {...thumb} /></span>
							)}
							<span class="palette__text"><span class="palette__label">{result.label}</span><span class="palette__detail">{result.detail}</span></span>
							<span class="palette__kind">{result.kind}</span>
						</div>
					))}
				</div>
				</div>
				<div class="palette__footer">
					<span><kbd>Tab</kbd> for actions</span>
					<span class="palette__footer-end"><kbd>↑</kbd><kbd data-key-down>↓</kbd> to navigate</span>
					<span><kbd data-key-enter>↵</kbd> to select</span>
				</div>
			</div>
		</div>
	</article>

	<article id="color-search" class="feature feature--color scroll-anchor">
		<div class="feature__aura" aria-hidden="true"></div>
		<div class="feature__copy">
			<div class="feature__eyebrow"><span>Color search</span></div>
			<h2>Follow a color back to the image.</h2>
			<p>Pick a color to find matching images in your Inbox or collection.</p>
		</div>
		<!-- The Inbox board with the app's colour filter bar floating over the masonry grid. -->
		<div class="feature-visual color-visual" role="img" aria-label="Color search in the Inbox, picking green, blue and red in turn" data-demo="color">
			<div class="mock inbox" aria-hidden="true" data-mock>
				<!-- The app's top bar (app-header): sidebar toggle, breadcrumb, and the Inbox's grid density switch. -->
				<div class="app-topbar">
					<span class="app-topbar__toggle"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /></svg></span>
					<span class="app-topbar__crumb">Inbox</span>
					<span class="density"><span>Spacious</span><span class="is-active">Balanced</span><span>Compact</span></span>
				</div>
				<div class="inbox__board">
				<div class="filter-bar">
					<div class="island filter-bar__type">Color <svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg></div>
					<div class="island filter-bar__colors">
						<span class="filter-bar__add"><svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="M5 12h14" /><path d="M12 5v14" /></svg></span>
						<span class="filter-bar__sep"></span>
						<span class="filter-bar__swatches">
							{filterColors.map((color) => <i class:list={[color === '#22c55e' && 'is-active']} data-swatch={color} style={`background-color: ${color}`}></i>)}
						</span>
					</div>
					<div class="island filter-bar__status"><span data-count>12</span>&nbsp;matches</div>
					<div class="island filter-bar__clear"><svg class="mock-icon mock-icon--xs" viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></div>
				</div>
				<div class="masonry-stack">
					{colorResults.map((result, index) => (
						<div class:list={['masonry', index === 0 && 'is-shown']} data-results-for={result.color} data-count-for={result.count}>
							{result.columns.map((column) => (
								<div class="masonry__column">{column.map((image) => <div class="masonry__card"><Image src={image} {...tile} /></div>)}</div>
							))}
						</div>
					))}
				</div>
				</div>
				<svg class="mock-cursor" data-cursor viewBox="0 0 24 24"><path d={pointer} /></svg>
			</div>
		</div>
	</article>

	<article class="feature feature--notes">
		<div class="feature__aura" aria-hidden="true"></div>
		<div class="feature__copy">
			<div class="feature__eyebrow"><span>AI writing</span></div>
			<h2>Make more of the thoughts you save.</h2>
			<p>Ask AI to help write or refine a passage, right where your ideas live.</p>
		</div>
		<!-- The note view and the agent's prompt (board/note-editor/agent). -->
		<div class="feature-visual note-visual" role="img" aria-label="Opening AI on an empty line with the space bar and generating formatted text" data-demo="note">
			<div class="mock note-window" aria-hidden="true" data-mock>
				<div class="note-window__header">
					<div class="note-window__group">
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M15 3v18" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon mock-icon--sm" viewBox="0 0 24 24"><path d="M4 14h6v6" /><path d="M20 10h-6V4" /><path d="m14 10 7-7" /><path d="m3 21 7-7" /></svg></span>
					</div>
					<div class="note-window__group">
						<span class="note-window__status" data-save-status>Edited 2m ago</span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><path d="m9 11-6 6v3h9l3-3" /><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg></span>
						<span class="note-window__button"><svg class="mock-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg></span>
					</div>
				</div>
				<div class="note-window__page">
					<div class="note-editor__title">Entrance study</div>
					<div class="note-editor__body">
						<p>The curve softens the space, and the light does most of the work in the morning.</p>
						<div class="note-editor__passage">
							<span class="agent-rail" data-rail></span>
							<p class="note-editor__empty" data-empty><span data-hint>Press space for AI or @ for mentions…</span></p>
							<p class="note-editor__draft" data-draft-row hidden><span data-draft></span></p>
							<div class="agent-prompt" data-prompt data-phase="prompt" hidden>
								<div class="agent-prompt__status"><span class="agent-shimmer">Writing…</span><span class="agent-prompt__ghost">Stop <kbd>Esc</kbd></span></div>
								<div class="agent-prompt__review">
									<span class="agent-prompt__icon-button"><svg class="mock-icon mock-icon--sm" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg></span>
									<span class="agent-button agent-button--secondary">Discard</span>
									<span class="agent-button agent-button--primary" data-keep>Keep</span>
								</div>
								<div class="agent-prompt__input">
									<span data-instruction>Develop the entrance concept</span><i class="mock-caret"></i>
									<span class="agent-prompt__send" data-send><svg class="mock-icon" viewBox="0 0 24 24"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg></span>
								</div>
								<div class="agent-prompt__actions"><span>Continue writing</span><span>Summarize</span><span>Outline</span><span>Action items</span></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</article>
</section>

<script>
	import '../scripts/feature-showcase';
</script>

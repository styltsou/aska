---
import { Image } from 'astro:assets';
import HeroWorkspace from './HeroWorkspace.astro';
import watercolor from '../assets/images/hero.webp';

interface Props {
	signupHref: string;
}

const { signupHref } = Astro.props;
---

<section class="hero">
	<div class="hero__stage">
		<div class="hero__media">
			<Image class="hero__backdrop" src={watercolor} alt="" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" quality={80} loading="eager" fetchpriority="high" decoding="sync" />
			<div class="hero__window"><div class="hero__window-frame"><HeroWorkspace /></div></div>
		</div>
		<div class="hero__inner">
			<div class="hero__copy">
				<h1>Keep the reference.<br /><span>Find the direction.</span></h1>
				<p class="hero__lede">
					Mnemee brings images, videos, links, and notes into one visual workspace. Collect what catches your eye, arrange it on a canvas, and find it again when it matters.
				</p>
				<div class="hero__actions">
					<a class="app-button app-button--outline" href="#workflow">Learn more</a>
					<a class="app-button app-button--primary" href={signupHref}>Create your workspace</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import '../scripts/hero-scroll';
</script>

<style>
	/*
	 * Split hero: copy sits bottom-left inside the page width, and the image panel fills the right side of the viewport,
	 * inset on three sides and tucked up under the (transparent at the top) navbar, whose account buttons float over it.
	 */
	.hero {
		--inset: 16px;
		/* Same 28px gutter as the full-width navbar over the hero, so the text lines up with the logo. */
		--gutter: 28px;
		--page-w: min(calc(100% - 48px), var(--page-width));
		position: relative;
		height: clamp(660px, 100svh, 1000px);
		margin-top: -52px;
	}
	.hero__stage { position: relative; height: 100%; }
	.hero__inner { display: flex; align-items: flex-end; width: calc(100% - 2 * var(--gutter)); height: 100%; margin-inline: auto; padding-bottom: clamp(48px, 7vh, 88px); }
	.hero__copy { position: relative; z-index: 1; display: flex; flex-direction: column; width: calc(50% - 56px); max-width: 600px; }

	h1 { margin-bottom: 22px; font-size: clamp(40px, 4.2vw, 64px); font-weight: 560; letter-spacing: -.045em; line-height: 1.03; text-wrap: balance; }
	h1 span { color: var(--ink-muted); }
	.hero__lede { max-width: 470px; margin-bottom: 32px; color: var(--ink-muted); font-size: 16px; line-height: 1.6; }
	.hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }

	/* The page-width split always lands on the hero's centre line. */
	.hero__media { position: absolute; top: var(--inset); right: var(--inset); bottom: var(--inset); left: 50%; overflow: hidden; border-radius: 12px; background: #6f9fc4; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 6%); isolation: isolate; }
	.hero__media::before { content: ''; position: absolute; z-index: 3; inset: var(--border-top, 0px) 0 0 var(--border-left, 0px); border: 1px solid var(--line); border-radius: inherit; pointer-events: none; }
	/* Light mode: a cobalt-to-navy wash multiplied over the watercolour deepens it without greying it the way brightness() does. */
	.hero__media::after { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: linear-gradient(165deg, rgb(52 98 168 / 30%), rgb(16 38 84 / 50%)); mix-blend-mode: multiply; pointer-events: none; }
	.hero__backdrop { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; filter: saturate(1.4) contrast(1.12) brightness(.9); transform: scale(1.04); }
	.hero__window { position: absolute; top: max(96px, 14%); left: 9%; width: max(128%, 780px); transform-origin: 0 0; }
	.hero__window-frame { filter: drop-shadow(0 30px 40px rgb(8 24 48 / 30%)) drop-shadow(0 6px 12px rgb(8 24 48 / 16%)); }
	.hero__window :global(.hero-workspace) { box-shadow: 0 0 0 1px rgb(255 255 255 / 55%); }

	/* The watercolour is deepened in light mode so the white mock-up stands out, and shown as-is (light) in dark mode for the dark mock-up. */
	:global(html[data-theme='dark']) .hero__media { background: #cfe3f2; }
	:global(html[data-theme='dark']) .hero__backdrop { filter: saturate(1.15) contrast(1.06); }
	:global(html[data-theme='dark']) .hero__media::after { mix-blend-mode: normal; background: linear-gradient(160deg, rgb(255 255 255 / 12%), rgb(255 255 255 / 0%) 55%, rgb(8 24 48 / 10%)); }
	:global(html[data-theme='dark']) .hero__window-frame { filter: drop-shadow(0 30px 40px rgb(8 24 48 / 34%)) drop-shadow(0 6px 12px rgb(8 24 48 / 20%)); }
	:global(html[data-theme='dark']) .hero__window :global(.hero-workspace) { box-shadow: 0 0 0 1px rgb(255 255 255 / 14%); }

	/*
	 * Pinned version (the script drives it). The hero gets extra height to scroll through while the stage sticks to the
	 * viewport. The panel takes its final, full box from the start and is clipped to the right half, so the first frame
	 * looks exactly like the static layout above.
	 */
	@media (min-width: 1024px) and (min-height: 620px) and (prefers-reduced-motion: no-preference) {
		.hero { --travel: 260svh; height: calc(100svh + var(--travel)); }
		.hero__stage { position: sticky; top: 0; height: 100svh; }
		.hero__media { --border-left: 50%; z-index: 2; left: var(--inset); box-shadow: none; clip-path: inset(0 0 0 50% round 12px); }
		.hero__backdrop { transform: scale(1.1); will-change: transform; }
		.hero__window { top: max(96px, 14%); left: 54.5%; width: max(64%, 780px); will-change: transform; }
	}

	/* Below desktop the panel drops under the copy and the navbar sits above the hero as usual. */
	@media (max-width: 1023px) {
		.hero { height: auto; margin-top: 0; padding: 56px 0 24px; }
		.hero__stage { display: flex; flex-direction: column; gap: 40px; height: auto; }
		.hero__inner { order: 1; width: var(--page-w); height: auto; padding-bottom: 0; }
		.hero__copy { width: auto; max-width: 640px; }
		.hero__media { position: relative; inset: auto; order: 2; width: calc(100% - 2 * var(--inset)); margin-inline: auto; aspect-ratio: 4 / 3; }
		.hero__window { top: 14%; width: 118%; }
	}
	@media (max-width: 640px) {
		.hero { padding-top: 40px; }
		.hero__stage { gap: 36px; }
		.hero__inner { width: calc(100% - 32px); }

		h1 { font-size: clamp(38px, 10.5vw, 56px); }
		.hero__lede { font-size: 15px; }
		.hero__actions .app-button { flex: 1 1 auto; }
		.hero__media { width: calc(100% - 16px); aspect-ratio: 1 / 1.05; border-radius: 12px; }
		.hero__window { top: 12%; left: 8%; width: 165%; }
	}
	@media (max-width: 370px) { h1 { font-size: 34px; } }

	/*
	 * Pinned on phones and tablets (the script drives it): the stage sticks right under the navbar. The panel takes its final,
	 * full box and is clipped down to the card below the copy; scrolling grows it upward to cover the stage.
	 */
	@media (max-width: 1023px) and (min-height: 560px) and (prefers-reduced-motion: no-preference) {
		.hero { --travel: 220svh; height: calc(100svh - 52px + var(--travel)); padding: 0; }
		.hero__stage { position: sticky; top: 52px; display: block; height: calc(100svh - 52px); }
		.hero__inner { padding-top: 24px; }
		.hero__media { --border-top: 62%; --border-left: 0px; position: absolute; inset: var(--inset); z-index: 2; width: auto; margin: 0; aspect-ratio: auto; box-shadow: none; clip-path: inset(62% 0 0 0 round 12px); }
		.hero__backdrop { transform: scale(1.1); will-change: transform; }
		.hero__window { top: 0; left: 0; width: 100%; will-change: transform; }
	}
</style>

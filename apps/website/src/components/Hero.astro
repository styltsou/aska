---
import HeroWorkspace from './HeroWorkspace.astro';

interface Props {
	signupHref: string;
}

const { signupHref } = Astro.props;
---

<section class="hero">
	<div class="hero__copy">
		<p class="hero__eyebrow">A home for the things you notice</p>
		<h1>Keep the reference.<br /><span>Find the direction.</span></h1>
		<p class="hero__lede">
			Mnemee brings images, videos, links, and notes into one visual workspace. Collect what catches your eye, arrange it on a canvas, and find it again when it matters.
		</p>
		<div class="hero__actions">
			<a class="button button--primary" href={signupHref}>Create your workspace</a>
			<a class="hero__text-link" href="#workflow">Explore how it works <span aria-hidden="true">↗</span></a>
		</div>
	</div>
	<div class="hero-workspace-stage"><HeroWorkspace /><p>References in a space made to think with.</p></div>
</section>

<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; gap: clamp(36px, 5vw, 84px); width: min(calc(100% - 64px), 1200px); min-height: min(740px, calc(100dvh - 74px)); margin-inline: auto; padding-block: clamp(80px, 9vw, 130px); }
	.hero__copy { position: relative; z-index: 20; max-width: 670px; margin-inline: auto; }
	.hero__eyebrow { margin-bottom: 24px; color: var(--ink-muted); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
	h1 { max-width: 660px; margin-bottom: 24px; font-size: clamp(44px, 4.2vw, 64px); font-weight: 560; letter-spacing: -.052em; line-height: 1.02; }
	h1 span { color: var(--ink-muted); }
	.hero__lede { max-width: 460px; margin-bottom: 26px; color: var(--ink-muted); font-size: 16px; line-height: 1.6; }
	.hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }
	.hero__actions .button { min-height: 42px; padding-inline: 16px; font-size: 13px; }
	.hero__text-link { font-size: 13px; font-weight: 550; }
	.hero__text-link span { margin-left: 4px; }
	.hero-workspace-stage { min-width: 0; }
	.hero-workspace-stage p { margin: 10px 0 0; color: var(--ink-muted); font-size: 11px; text-align: right; }
	@media (max-width: 1180px) { .hero { grid-template-columns: 1fr; gap: 48px; min-height: 0; padding-top: 92px; }.hero__copy { max-width: 720px; margin: 0; }.hero-workspace-stage { width: min(100%, 760px); } }
	@media (max-width: 640px) { .hero { width: min(calc(100% - 32px), 1200px); gap: 42px; padding-block: 70px 86px; }.hero__eyebrow { font-size: 10px; } h1 { font-size: clamp(39px, 10vw, 58px); } .hero__lede { font-size: 15px; } .hero-workspace-stage p { font-size: 10px; } }
	@media (max-width: 370px) { h1 { font-size: 36px; } }
</style>

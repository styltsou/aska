---
interface Props {
	signupHref: string;
}

const { signupHref } = Astro.props;
---

<section class="closing" data-header-surface="canvas">
	<div class="closing__frame page-width">
		<div><h2>Make room for what inspires you.</h2>
		<p>Start collecting. The shape of the project can come later.</p></div>
		<a class="button button--primary" href={signupHref}>Create your workspace</a>
	</div>
</section>

<style>
	.closing { padding-bottom: clamp(100px, 12vw, 170px); }
	.closing__frame { display: flex; align-items: end; justify-content: space-between; gap: 30px; padding: 58px 0 0; border-top: 1px solid var(--line); }
	h2 { max-width: 620px; margin-bottom: 13px; font-size: clamp(34px, 4vw, 54px); letter-spacing: -.04em; line-height: 1.1; }
	p { max-width: 460px; margin: 0; color: var(--ink-muted); font-size: 15px; line-height: 1.55; }
	.closing .button { flex: 0 0 auto; min-height: 44px; padding-inline: 18px; font-size: 13px; }

	@media (max-width: 640px) {
		.closing__frame { align-items: flex-start; flex-direction: column; }
	}

</style>

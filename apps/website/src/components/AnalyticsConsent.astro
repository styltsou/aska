---
const posthogKey = import.meta.env.PROD ? import.meta.env.PUBLIC_POSTHOG_KEY : undefined;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com';
---

{(import.meta.env.DEV || posthogKey) && (
	<div class="consent" data-consent data-key={posthogKey} data-host={posthogHost}>
		<section class="consent__panel" data-consent-panel hidden aria-label="Analytics preferences">
			<h2>Help us improve Mnemee</h2>
			<p>Essential cookies and storage keep Mnemee working, including account sign-in. With your permission, we use PostHog analytics to understand visits to this website. You can change your choice at any time. <a href="/privacy">Privacy details</a></p>
			<div class="consent__preferences" data-consent-preferences hidden>
				<label class="consent__option"><span><strong>Essential</strong><small>Needed for the service, including account sign-in.</small></span><input type="checkbox" checked disabled aria-label="Essential cookies, always enabled" /></label>
				<label class="consent__option"><span><strong>Analytics (PostHog)</strong><small>Helps us understand visits to the website.</small></span><input type="checkbox" data-consent-analytics /></label>
			</div>
			<div class="consent__actions" data-consent-initial-actions>
				<button type="button" class="app-button app-button--secondary" data-consent-edit>Edit preferences</button>
				<button type="button" class="app-button app-button--primary" data-consent-accept>Accept analytics</button>
			</div>
			<div class="consent__actions" data-consent-preference-actions hidden>
				<button type="button" class="app-button app-button--primary" data-consent-save>Save preferences</button>
			</div>
		</section>
	</div>
)}

<script>
	import '../scripts/analytics-consent';
</script>

<style>
	.consent { position: relative; z-index: 100; }
	.consent__panel { position: fixed; right: auto; bottom: 8px; left: 50%; width: min(440px, calc(100vw - 32px)); padding: 14px; transform: translateX(-50%); border: 1px solid #3c3c3c; border-radius: 8px; background: #171717; color: #f5f5f5; box-shadow: 0 10px 36px rgb(0 0 0 / 30%); }
	.consent__panel[hidden] { display: none; }
	.consent__panel h2 { margin: 0 0 6px; font-size: 16px; }
	.consent__panel p { margin: 0; color: #c9c9c9; font-size: 12px; line-height: 1.5; }
	.consent__panel a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
	.consent__preferences { margin-top: 12px; border-top: 1px solid #555; }
	.consent__preferences[hidden], .consent__actions[hidden] { display: none; }
	.consent__option { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid #555; cursor: pointer; }
	.consent__option span { display: grid; gap: 3px; }.consent__option strong { font-size: 13px; }.consent__option small { color: #c9c9c9; font-size: 12px; line-height: 1.4; }
	.consent__option input { width: 18px; height: 18px; flex: none; accent-color: #eee; }
	.consent__option input:disabled { opacity: .65; cursor: not-allowed; }
	.consent__actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
	.consent__actions .app-button { min-width: 0; height: 34px; padding-inline: 10px; border-radius: .45rem; font-size: 12px; }
	.consent__actions .app-button--primary { border-color: #dedede; background: #f5f5f5; color: #171717; box-shadow: inset 0 1px 0 rgb(255 255 255 / 45%), 0 1px 2px rgb(0 0 0 / 15%); }
	.consent__actions .app-button--secondary { border-color: #555; background: #292929; color: #f5f5f5; box-shadow: 0 1px 1px rgb(0 0 0 / 15%); }
	:global(html[data-theme='dark']) .consent__panel { border-color: #d7d7d7; background: #fff; color: #171717; box-shadow: 0 12px 44px rgb(0 0 0 / 55%); }
	:global(html[data-theme='dark']) .consent__panel p { color: #555; }
	:global(html[data-theme='dark']) .consent__panel a { color: #171717; }
	:global(html[data-theme='dark']) .consent__preferences, :global(html[data-theme='dark']) .consent__option { border-color: #ddd; }
	:global(html[data-theme='dark']) .consent__option small { color: #555; }
	:global(html[data-theme='dark']) .consent__option input { accent-color: #171717; }
	:global(html[data-theme='dark']) .consent__actions .app-button--primary { border-color: #292929; background: #171717; color: #f5f5f5; }
	:global(html[data-theme='dark']) .consent__actions .app-button--secondary { border-color: #dedede; background: #f5f5f5; color: #171717; }
	@media (max-width: 380px) { .consent__panel { bottom: 8px; width: calc(100vw - 24px); padding: 12px; }.consent__actions { flex-wrap: wrap; }.consent__actions .app-button { flex: 1; padding-inline: 8px; } }
</style>

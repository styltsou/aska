---
import Closing from '../components/Closing.astro';
import ArchivePrinciples from '../components/ArchivePrinciples.astro';
import BrowserExtension from '../components/BrowserExtension.astro';
import Faq from '../components/Faq.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StatementBand from '../components/StatementBand.astro';
import Layout from '../layouts/Layout.astro';

const appBaseUrl = (import.meta.env.PUBLIC_APP_URL ?? 'https://app.mnemee.space').replace(/\/+$/, '');
const loginHref = `${appBaseUrl}/login`;
const signupHref = `${appBaseUrl}/signup`;
---

<Layout
	title="Mnemee | A visual workspace for your references"
	description="Collect images, videos, links, and notes. Arrange ideas on a canvas and find the references you need with Mnemee."
>
	<SiteHeader loginHref={loginHref} signupHref={signupHref} />
	<main>
		<div class="intro-surface" data-header-surface="surface"><Hero signupHref={signupHref} /></div>
		<div class="hero-transition" data-header-surface="surface" data-fade="surface canvas" aria-hidden="true"></div>
		<StatementBand />
		<FeatureShowcase />
		<BrowserExtension />
		<ArchivePrinciples />
		<div class="surface-fade surface-fade--in" data-header-surface="surface" data-fade="canvas surface" aria-hidden="true"></div>
		<Faq />
		<div class="surface-fade surface-fade--out" data-header-surface="surface" data-fade="surface canvas" aria-hidden="true"></div>
		<Closing signupHref={signupHref} />
	</main>
	<SiteFooter loginHref={loginHref} signupHref={signupHref} />
</Layout>

<script>
	// Match the native scrollbar track to the page surface at the center of the viewport.
	const root = document.documentElement;
	const heroFade = document.querySelector<HTMLElement>('.hero-transition');
	const faqIn = document.querySelector<HTMLElement>('.surface-fade--in');
	const faqOut = document.querySelector<HTMLElement>('.surface-fade--out');
	const main = document.querySelector<HTMLElement>('main');
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
	let scrollbarFrame = 0;
	let previousTrack = '';
	const smooth = (t: number) => { const v = Math.max(0, Math.min(1, t)); return v * v * v * (v * (v * 6 - 15) + 10); };
	const updateScrollbar = () => {
		scrollbarFrame = 0;
		// Classic scrollbars consume layout width; mirror that width on the left.
		const gutter = finePointer.matches ? Math.max(0, window.innerWidth - root.clientWidth) : 0;
		root.style.setProperty('--left-scrollbar-gutter', `${gutter}px`);
		if (!finePointer.matches || !heroFade || !faqIn || !faqOut || !main) return;
		const point = window.innerHeight / 2;
		const hero = heroFade.getBoundingClientRect();
		const beforeFaq = faqIn.getBoundingClientRect();
		const afterFaq = faqOut.getBoundingClientRect();
		const reach = Math.max(140, Math.min(280, window.innerHeight * .24));
		const pad = Math.max(56, Math.min(96, window.innerWidth * .07));
		let surface = 0;
		if (point < hero.bottom) surface = 1 - smooth((point - hero.top) / hero.height);
		else if (point >= beforeFaq.top - reach && point < afterFaq.bottom + reach) {
			surface = Math.min(smooth((point - (beforeFaq.top - reach)) / (beforeFaq.height + reach + pad)), 1 - smooth((point - (afterFaq.top - pad)) / (afterFaq.height + reach + pad)));
		}
		const track = main.getBoundingClientRect().bottom <= point ? 'var(--footer-surface)' : `color-mix(in oklab, var(--surface) ${(surface * 100).toFixed(1)}%, var(--canvas))`;
		if (track !== previousTrack) { root.style.setProperty('--scrollbar-track', track); previousTrack = track; }
	};
	const scheduleScrollbar = () => { if (!scrollbarFrame) scrollbarFrame = requestAnimationFrame(updateScrollbar); };
	window.addEventListener('scroll', scheduleScrollbar, { passive: true });
	window.addEventListener('resize', scheduleScrollbar);
	finePointer.addEventListener('change', scheduleScrollbar);
	updateScrollbar();
	document.addEventListener('astro:before-swap', () => {
		window.removeEventListener('scroll', scheduleScrollbar);
		window.removeEventListener('resize', scheduleScrollbar);
		finePointer.removeEventListener('change', scheduleScrollbar);
		cancelAnimationFrame(scrollbarFrame);
		root.style.removeProperty('--scrollbar-track');
		root.style.removeProperty('--left-scrollbar-gutter');
	}, { once: true });
</script>

<style>
	main {
		position: relative;
		z-index: 1;
		margin-bottom: var(--footer-reveal, 0px);
		background: var(--canvas);
		border-bottom: 1px solid var(--line);
		border-radius: 0 0 var(--sheet-radius) var(--sheet-radius);
		box-shadow: var(--sheet-shadow);
	}
	.intro-surface { display: grid; min-height: calc(100svh - 52px); background: var(--surface); }
	/*
	 * Section fades. A plain linear ramp shows a hard start and end, and across these close greys it bands. The ramp
	 * follows smootherstep (6t⁵ − 15t⁴ + 10t³) in 21 stops, which leaves both ends flat, so there's no visible line where
	 * the fade meets the solid colour. In dark mode a balanced black/white dither breaks up the remaining steps without
	 * shifting the average brightness (a plain grey grain lightens dark greys, which itself shows as an edge where it stops).
	 * Light mode needs none: its two whites are only a few levels apart.
	 */
	.hero-transition, .surface-fade {
		--ramp:
			var(--from),
			color-mix(in oklab, var(--to) .12%, var(--from)) 5%,
			color-mix(in oklab, var(--to) .86%, var(--from)) 10%,
			color-mix(in oklab, var(--to) 2.66%, var(--from)) 15%,
			color-mix(in oklab, var(--to) 5.79%, var(--from)) 20%,
			color-mix(in oklab, var(--to) 10.35%, var(--from)) 25%,
			color-mix(in oklab, var(--to) 16.31%, var(--from)) 30%,
			color-mix(in oklab, var(--to) 23.52%, var(--from)) 35%,
			color-mix(in oklab, var(--to) 31.74%, var(--from)) 40%,
			color-mix(in oklab, var(--to) 40.69%, var(--from)) 45%,
			color-mix(in oklab, var(--to) 50%, var(--from)) 50%,
			color-mix(in oklab, var(--to) 59.31%, var(--from)) 55%,
			color-mix(in oklab, var(--to) 68.26%, var(--from)) 60%,
			color-mix(in oklab, var(--to) 76.48%, var(--from)) 65%,
			color-mix(in oklab, var(--to) 83.69%, var(--from)) 70%,
			color-mix(in oklab, var(--to) 89.65%, var(--from)) 75%,
			color-mix(in oklab, var(--to) 94.21%, var(--from)) 80%,
			color-mix(in oklab, var(--to) 97.34%, var(--from)) 85%,
			color-mix(in oklab, var(--to) 99.14%, var(--from)) 90%,
			color-mix(in oklab, var(--to) 99.88%, var(--from)) 95%,
			var(--to);
		position: relative;
	}
	.hero-transition { --from: var(--surface); --to: var(--canvas); height: max(80px, calc(var(--section-gap) - 40px)); background: linear-gradient(to bottom, var(--ramp)); }

	/*
	 * The fades around the FAQ are long washes rather than blocks: each one is a background layer (z-index -1, so under
	 * every section's content but over the page canvas) that reaches well into the section above and below. The spacer
	 * itself only sets the gap. The FAQ paints its own surface inside its content box only (see Faq.astro), so the wash
	 * reaches its full colour exactly where the FAQ frame starts and leaves from exactly where it ends.
	 * `--fade-pad` matches the FAQ's padding-block; `--reach` is how far the wash runs into the neighbouring section.
	 */
	.surface-fade { --fade-pad: clamp(56px, 7vw, 96px); --reach: clamp(140px, 24vh, 280px); height: calc(var(--section-gap) - var(--fade-pad)); }
	.surface-fade--in { --from: var(--canvas); --to: var(--surface); }
	/* Both fades set the same gap, so the FAQ sits evenly between the use cases above and the closing call to action below. */
	.surface-fade--out { --from: var(--surface); --to: var(--canvas); }
	.surface-fade::before { content: ''; position: absolute; right: 0; left: 0; z-index: -1; background: linear-gradient(to bottom, var(--ramp)); pointer-events: none; }
	.surface-fade--in::before { top: calc(-1 * var(--reach)); bottom: calc(-1 * var(--fade-pad)); }
	.surface-fade--out::before { top: calc(-1 * var(--fade-pad)); bottom: calc(-1 * var(--reach)); }

	/* Dark-mode dither, over the same extent as each fade. Being brightness-neutral, it needs no taper at the ends. */
	:global(html[data-theme='dark']) .hero-transition::after,
	:global(html[data-theme='dark']) .surface-fade::after { content: ''; position: absolute; right: 0; left: 0; background: url('/fade-dither.svg'); pointer-events: none; }
	:global(html[data-theme='dark']) .hero-transition::after { top: 0; bottom: 0; }
	:global(html[data-theme='dark']) .surface-fade::after { z-index: -1; }
	:global(html[data-theme='dark']) .surface-fade--in::after { top: calc(-1 * var(--reach)); bottom: calc(-1 * var(--fade-pad)); }
	:global(html[data-theme='dark']) .surface-fade--out::after { top: calc(-1 * var(--fade-pad)); bottom: calc(-1 * var(--reach)); }

	@media (max-width: 640px) { .surface-fade { --reach: 120px; } }
</style>

{
  "name": "server",
  "scripts": {
    "dev": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run --config vitest.integration.config.ts",
    "backfill:resolver-version": "bun run src/scripts/backfill-resolver-version.ts",
    "backfill:video-storyboards": "bun run src/scripts/backfill-video-storyboards.ts",
    "agent:eval": "bun run src/scripts/agent-eval.ts",
    "test:agent": "bun test --path-ignore-patterns=\"**/*.integration.test.ts\" src/agent",
    "test:watch": "vitest",
    "lambda:typecheck": "tsc --noEmit -p tsconfig.lambda.json",
    "db:check": "drizzle-kit generate && git diff --exit-code -- drizzle"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/client-sqs": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1081.0",
    "@better-auth/api-key": "^1.6.23",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.8.0",
    "@langchain/core": "^1.3.1",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.3",
    "@mnemee/image-shared": "workspace:*",
    "@mnemee/url-unfurl-shared": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@scalar/hono-api-reference": "^0.11.9",
    "@sentry/aws-serverless": "^10.69.0",
    "@sentry/hono": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "better-auth": "^1.6.23",
    "color-namer": "^1.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.27",
    "htmlparser2": "^10.0.0",
    "resend": "^6.17.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "sst": "^4.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "esbuild": "^0.25.10",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

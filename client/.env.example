VITE_SERVER_URL=http://localhost:3000

# Sentry is disabled locally when the DSN is unset.
# VITE_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=aska@local
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Production source-map upload settings are read only by Vite's build process.
# Never prefix the auth token with VITE_; it must not enter the browser bundle.
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=aska

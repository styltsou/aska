#!/bin/sh

set -eu

# Format staged source files with each package's own oxfmt install. Each
# package is formatted from its own directory because the ignore patterns in
# .oxfmtrc.json (e.g. src/routeTree.gen.ts) are package-relative.
root="$(git rev-parse --show-toplevel)"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged_files" ] || exit 0

format_package() {
  package="$1"
  files="$(printf '%s\n' "$staged_files" | grep -E "^$package/.*\.(css|js|jsx|mjs|json|jsonc|ts|tsx)$" || true)"
  [ -n "$files" ] || return 0

  relative_files="$(printf '%s\n' "$files" | sed "s#^$package/##")"
  # shellcheck disable=SC2086 # Word splitting is intended: one path per word.
  (cd "$root/$package" && bun ./node_modules/oxfmt/bin/oxfmt --write $relative_files)
  # shellcheck disable=SC2086
  (cd "$root" && git add $files)
}

# Every workspace package with a format script, so new packages are covered
# without editing this hook.
for manifest in "$root"/apps/*/package.json "$root"/services/*/package.json "$root"/packages/*/package.json; do
  [ -f "$manifest" ] || continue
  grep -q '"format":' "$manifest" || continue
  package_dir="$(dirname "$manifest")"
  [ -f "$package_dir/node_modules/oxfmt/bin/oxfmt" ] || continue
  format_package "${package_dir#"$root"/}"
done

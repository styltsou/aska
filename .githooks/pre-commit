#!/bin/sh

set -eu

# Format staged source files with each package's own oxfmt install. Each
# package is formatted from its own directory because the ignore patterns in
# .oxfmtrc.json (e.g. src/routeTree.gen.ts) are package-relative.
root="$(git rev-parse --show-toplevel)"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

format_package() {
  package="$1"
  pattern="$2"
  files="$(printf '%s\n' "$staged_files" | grep -E "^$package/.*\.($pattern)$" || true)"
  [ -n "$files" ] || return 0

  relative_files="$(printf '%s\n' "$files" | sed "s#^$package/##")"
  # shellcheck disable=SC2086 # Word splitting is intended: one path per word.
  (cd "$root/$package" && bun ./node_modules/oxfmt/bin/oxfmt --write $relative_files)
  # shellcheck disable=SC2086
  (cd "$root" && git add $files)
}

format_package apps/web 'css|js|jsx|json|ts|tsx'
format_package apps/server 'json|ts'
for service in gradient-naming image-variants image-palette url-resolution video-processor; do
  format_package "services/$service" 'json|ts'
done
for package in image-shared url-unfurl-shared; do
  format_package "packages/$package" 'json|ts'
done

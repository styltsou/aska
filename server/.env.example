DATABASE_URL=postgresql://user:password@localhost:5432/aska

BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Required only when CROSS_SITE_AUTH_COOKIES=true. Use the narrowest shared
# parent domain for the app and API, e.g. .example.com.
# AUTH_COOKIE_DOMAIN=.example.com

# Set both only when requests pass through a Cloudflare Access application.
# The deployed dev stage injects them through SST; keep them unset locally.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=your-access-application-aud-tag

RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional: enables the in-app Unsplash browser. Without it, its endpoints
# respond with 501 so local development and CI can run without a provider key.
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
LOG_SLOW_REQUEST_MS=1000
# Set to 0.1 in a high-volume production environment. Errors, 4xx responses,
# and slow requests are always retained regardless of this setting.
LOG_SUCCESS_SAMPLE_RATIO=1

# Sentry is disabled locally when the DSN is unset. Structured logs still go
# to stdout so local development and CloudWatch remain useful.
# SENTRY_DSN=https://8b63296e49a1b1b614674d5875dff23a@o4509639201325056.ingest.de.sentry.io/4511859259539536
# SENTRY_SERVICE=aska-api
# SENTRY_ENVIRONMENT=development
# Use the same release value for the client, API, and workers.
# SENTRY_RELEASE=aska@local
# SENTRY_TRACES_SAMPLE_RATE=0.2

S3_BUCKET=aska-dev
S3_REGION=eu-central-1
# Leave credentials unset to use your AWS profile locally. Set S3_ENDPOINT and
# the key pair only when using an S3-compatible local emulator.
# S3_ENDPOINT=http://localhost:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
S3_PRESIGNED_UPLOAD_EXPIRES_SECONDS=900
S3_PRESIGNED_READ_EXPIRES_SECONDS=900
# Leave these unset for local S3 reads. The stable SST deployment supplies all
# four values for private CloudFront delivery of workspace image objects.
# MEDIA_BASE_URL=https://images.example.com
# CLOUDFRONT_KEY_PAIR_ID=K123EXAMPLE
# CLOUDFRONT_PRIVATE_KEY_BASE64=<base64-encoded-pem>
# CLOUDFRONT_COOKIE_DOMAIN=.example.com
# CLOUDFRONT_SIGNED_COOKIE_EXPIRES_SECONDS=3600
MAX_DIRECT_UPLOAD_BYTES=20971520

IMAGE_PIPELINE_CALLBACK_SECRET=replace-with-at-least-32-characters
